/* ═══════════════════════════════════════════════════════════════════════════
   Aura — Premium Light Theme
   Apple/Framer clean white · Indigo accents · Breathing room
   ═══════════════════════════════════════════════════════════════════════════ */

/* ─── Global ────────────────────────────────────────────────────────────── */
QWidget {
    background-color: #F5F5F7;
    color: #1D1D1F;
    font-family: "Inter", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* Prevent label backgrounds from painting over card surfaces */
QLabel {
    background: transparent;
}

QWidget#centralWidget,
QWidget#scrollContent {
    background-color: #F5F5F7;
}

/* ─── Main Window ───────────────────────────────────────────────────────── */
QMainWindow {
    background-color: #F5F5F7;
}

/* ─── Scroll Area ───────────────────────────────────────────────────────── */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#dashboardScroll {
    background-color: #F5F5F7;
}

QScrollArea#dashboardScroll > QWidget {
    background-color: #F5F5F7;
}

/* ─── Sidebar ───────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E8E8ED;
}

/* Logo */
QLabel#logoText {
    font-size: 20px;
    font-weight: 800;
    color: #1D1D1F;
    letter-spacing: -0.5px;
}

/* Nav section label */
QLabel#navSectionLabel {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2.5px;
    color: #AEAEB2;
    padding: 16px 20px 6px 20px;
    background: transparent;
}

/* Sidebar buttons */
QPushButton#sidebarButton {
    text-align: left;
    padding: 11px 20px;
    border: none;
    border-radius: 10px;
    margin: 2px 10px;
    font-size: 13px;
    font-weight: 500;
    color: #6E6E73;
    background-color: transparent;
}

QPushButton#sidebarButton:hover {
    background-color: #F2F2F7;
    color: #1D1D1F;
}

QPushButton#sidebarButton[active="true"] {
    background-color: #EEF0FE;
    color: #4E5BF2;
    font-weight: 600;
    border-left: 3px solid #4E5BF2;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-left: 17px;
}

/* Version label at bottom */
QLabel#versionLabel {
    color: #AEAEB2;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
    padding: 6px 14px 10px 14px;
    background: transparent;
}

/* Sidebar bottom accent line */
QWidget#sidebarAccent {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent,
        stop:0.3 rgba(78, 91, 242, 0.25),
        stop:0.7 rgba(78, 91, 242, 0.25),
        stop:1 transparent
    );
}

/* Sidebar separator */
QWidget#separator {
    background-color: #E8E8ED;
}

/* ─── Top Bar ───────────────────────────────────────────────────────────── */
QWidget#topBar {
    background-color: #F5F5F7;
    border-bottom: 1px solid #E8E8ED;
}

QLabel#pageTitle {
    font-size: 17px;
    font-weight: 700;
    color: #1D1D1F;
    letter-spacing: -0.3px;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: #6E6E73;
    font-weight: 400;
}

/* Chat toggle button */
QPushButton#chatToggleButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4E5BF2, stop:1 #6D79F6);
    color: white;
    border-radius: 20px;
    font-size: 18px;
    font-weight: bold;
    border: none;
}

QPushButton#chatToggleButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6D79F6, stop:1 #8B96FA);
}

/* ─── Status Bar ───────────────────────────────────────────────────────── */
QWidget#statusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E8E8ED;
}

QLabel#statusText {
    font-size: 11px;
    color: #AEAEB2;
    font-weight: 500;
    background: transparent;
}

QLabel#statusTextSuccess {
    font-size: 11px;
    color: #34C759;
    font-weight: 500;
    background: transparent;
}

/* ─── Glass Card (Standard Container) ──────────────────────────────────── */
QFrame#glassCard {
    background-color: #FFFFFF;
    border-radius: 16px;
    border: 1px solid #E8E8ED;
}

QFrame#glassCard:hover {
    background-color: #FAFAFC;
    border: 1px solid #DDDDE2;
}

/* ─── Stat Card ─────────────────────────────────────────────────────────── */
QFrame#statCard {
    background-color: #FFFFFF;
    border-radius: 16px;
    border: 1px solid #E8E8ED;
}

QLabel#statValue {
    font-size: 34px;
    font-weight: 800;
    color: #1D1D1F;
    letter-spacing: -1.5px;
    background: transparent;
}

QLabel#statLabel {
    font-size: 11px;
    font-weight: 600;
    color: #AEAEB2;
    letter-spacing: 1.5px;
    background: transparent;
}

/* ─── Typography Hierarchy ─────────────────────────────────────────────── */
QLabel#sectionHeader {
    font-size: 22px;
    font-weight: 700;
    color: #1D1D1F;
    letter-spacing: -0.5px;
    background: transparent;
}

QLabel#sectionSubheader {
    font-size: 13px;
    color: #6E6E73;
    font-weight: 400;
    background: transparent;
}

/* Card section title */
QLabel#cardHeader {
    font-size: 14px;
    font-weight: 700;
    color: #1D1D1F;
    letter-spacing: -0.2px;
    background: transparent;
}

/* Form field labels */
QLabel#formLabel {
    font-size: 12px;
    font-weight: 600;
    color: #6E6E73;
    background: transparent;
}

/* Warning/info inline text */
QLabel#warningText {
    font-size: 12px;
    font-weight: 600;
    color: #FF9500;
    background: transparent;
}

QLabel#mutedText {
    font-size: 11px;
    color: #AEAEB2;
    background: transparent;
}

/* ─── Buttons ───────────────────────────────────────────────────────────── */
QPushButton#primaryButton {
    background-color: #4E5BF2;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1px;
}

QPushButton#primaryButton:hover {
    background-color: #5D6AF4;
}

QPushButton#primaryButton:pressed {
    background-color: #3D4AD0;
}

QPushButton#primaryButton:disabled {
    background-color: #E5E5EA;
    color: #AEAEB2;
}

QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #3C3C43;
    border: 1px solid #D1D1D6;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#secondaryButton:hover {
    background-color: #F2F2F7;
    border-color: #AEAEB2;
}

QPushButton#secondaryButton:disabled {
    background-color: #F2F2F7;
    color: #C7C7CC;
    border-color: #E5E5EA;
}

QPushButton#dangerButton {
    background-color: rgba(255, 59, 48, 0.08);
    color: #FF3B30;
    border: 1px solid rgba(255, 59, 48, 0.2);
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: rgba(255, 59, 48, 0.14);
    border-color: rgba(255, 59, 48, 0.35);
}

/* Dashboard export buttons */
QPushButton#exportButton {
    background: rgba(78, 91, 242, 0.07);
    color: #4E5BF2;
    border: 1px solid rgba(78, 91, 242, 0.2);
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
    font-size: 11px;
}

QPushButton#exportButton:hover {
    background: rgba(78, 91, 242, 0.12);
}

QPushButton#exportButtonSuccess {
    background: rgba(52, 199, 89, 0.08);
    color: #34C759;
    border: 1px solid rgba(52, 199, 89, 0.2);
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
    font-size: 11px;
}

QPushButton#exportButtonSuccess:hover {
    background: rgba(52, 199, 89, 0.14);
}

/* Action chip (chat panel suggestions) */
QPushButton#chipButton {
    background: #F2F2F7;
    color: #6E6E73;
    border: 1px solid #E5E5EA;
    border-radius: 14px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#chipButton:hover {
    background: #EEF0FE;
    color: #4E5BF2;
    border-color: rgba(78, 91, 242, 0.3);
}

/* ─── Inputs ────────────────────────────────────────────────────────────── */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D6;
    border-radius: 10px;
    height: 48px;
    padding: 0 16px;
    font-size: 13px;
    color: #1D1D1F;
    selection-background-color: #4E5BF2;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid #4E5BF2;
    background-color: #FFFFFF;
    padding: 0 15px;
    outline: 0;
}

QLineEdit:disabled {
    background-color: #F2F2F7;
    color: #AEAEB2;
    border-color: #E5E5EA;
}

QLineEdit[masked="true"] {
    font-family: "JetBrains Mono", "Consolas", monospace;
    letter-spacing: 2px;
}

QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D6;
    border-radius: 10px;
    height: 48px;
    padding: 0 12px;
    font-size: 13px;
    color: #1D1D1F;
}

QSpinBox:focus {
    border: 2px solid #4E5BF2;
    background-color: #FFFFFF;
    outline: 0;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 20px;
    border: none;
    background: transparent;
    margin-right: 4px;
}

QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #AEAEB2;
    height: 0;
    width: 0;
}

QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #AEAEB2;
    height: 0;
    width: 0;
}

QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D6;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 13px;
    color: #1D1D1F;
    selection-background-color: #4E5BF2;
    selection-color: #FFFFFF;
}

QTextEdit:focus {
    border: 2px solid #4E5BF2;
    background-color: #FFFFFF;
    outline: 0;
}

/* ─── Combo Box ────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D6;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    color: #1D1D1F;
    min-height: 20px;
}

QComboBox:hover {
    border-color: rgba(78, 91, 242, 0.5);
}

QComboBox:focus {
    border: 2px solid #4E5BF2;
    background-color: #FFFFFF;
    outline: 0;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #AEAEB2;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 10px;
    color: #1D1D1F;
    selection-background-color: rgba(78, 91, 242, 0.1);
    selection-color: #4E5BF2;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 9px 14px;
    border-radius: 6px;
    margin: 2px;
    color: #3C3C43;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #F2F2F7;
    color: #1D1D1F;
}

/* ─── Checkbox ──────────────────────────────────────────────────────────── */
QCheckBox {
    spacing: 10px;
    color: #3C3C43;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #D1D1D6;
    border-radius: 5px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: rgba(78, 91, 242, 0.5);
}

QCheckBox::indicator:checked {
    background-color: #4E5BF2;
    border-color: #4E5BF2;
}

QCheckBox::indicator:checked:hover {
    background-color: #5D6AF4;
}

/* ─── Table ─────────────────────────────────────────────────────────────── */
QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    font-size: 13px;
    selection-background-color: rgba(78, 91, 242, 0.08);
    selection-color: #1D1D1F;
    alternate-background-color: rgba(0, 0, 0, 0.012);
}

QTableWidget::item {
    padding: 13px 16px;
    border-bottom: 1px solid #F2F2F7;
    color: #3C3C43;
}

QTableWidget::item:selected {
    background-color: rgba(78, 91, 242, 0.08);
    color: #4E5BF2;
}

QTableWidget::item:hover:!selected {
    background-color: #F9F9FB;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: rgba(0, 0, 0, 0.02);
    color: #AEAEB2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 12px 16px;
    border: none;
    border-bottom: 1px solid #E8E8ED;
}

QHeaderView::section:first {
    border-top-left-radius: 0px;
}

/* ─── List Widget ──────────────────────────────────────────────────────── */
QListWidget {
    background-color: transparent;
    border: none;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 11px 14px;
    border-radius: 8px;
    margin: 1px 4px;
    color: #3C3C43;
    font-size: 13px;
}

QListWidget::item:selected {
    background-color: rgba(78, 91, 242, 0.1);
    color: #4E5BF2;
    font-weight: 600;
}

QListWidget::item:hover:!selected {
    background-color: #F2F2F7;
    color: #1D1D1F;
}

/* ─── Tab Widget ───────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #AEAEB2;
    padding: 10px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1px;
}

QTabBar::tab:selected {
    color: #1D1D1F;
    border-bottom: 2px solid #4E5BF2;
}

QTabBar::tab:hover:!selected {
    color: #3C3C43;
    background: rgba(0, 0, 0, 0.02);
}

/* ─── Scroll Bar ────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 0;
}

QScrollBar::handle:vertical {
    background: #D1D1D6;
    border-radius: 3px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(78, 91, 242, 0.5);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0 4px;
}

QScrollBar::handle:horizontal {
    background: #D1D1D6;
    border-radius: 3px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(78, 91, 242, 0.5);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ─── Progress Bar ──────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #E5E5EA;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    font-size: 1px;
    color: transparent;
    border: none;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4E5BF2, stop:1 #6D79F6);
    border-radius: 3px;
}

/* ─── Splitter ─────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #E8E8ED;
    width: 1px;
    margin: 4px 0;
}

QSplitter::handle:hover {
    background-color: rgba(78, 91, 242, 0.4);
}

/* ─── Group Box ─────────────────────────────────────────────────────────── */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 16px;
    margin-top: 24px;
    padding: 28px 24px 24px 24px;
    padding-top: 36px;
    font-weight: 600;
    color: #1D1D1F;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 12px;
    color: #AEAEB2;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ─── Badges ────────────────────────────────────────────────────────────── */
QLabel#badgeSuccess {
    background-color: rgba(52, 199, 89, 0.1);
    color: #34C759;
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QLabel#badgeWarning {
    background-color: rgba(255, 149, 0, 0.1);
    color: #FF9500;
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QLabel#badgeDanger {
    background-color: rgba(255, 59, 48, 0.1);
    color: #FF3B30;
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QLabel#badgeInfo {
    background-color: rgba(78, 91, 242, 0.1);
    color: #4E5BF2;
    border-radius: 8px;
    padding: 4px 14px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

/* ─── Toast Notifications ──────────────────────────────────────────────── */
QLabel#toastMessage {
    font-size: 13px;
    color: #3C3C43;
    background: transparent;
}

QPushButton#toastCloseButton {
    border: none;
    color: #AEAEB2;
    font-size: 14px;
    padding: 0;
    min-width: 20px;
    max-width: 20px;
    background: transparent;
}

QPushButton#toastCloseButton:hover {
    color: #6E6E73;
}

QFrame#toastSuccess {
    background-color: rgba(240, 253, 244, 0.98);
    border: 1px solid rgba(52, 199, 89, 0.3);
    border-radius: 12px;
}

QFrame#toastError {
    background-color: rgba(255, 245, 245, 0.98);
    border: 1px solid rgba(255, 59, 48, 0.3);
    border-radius: 12px;
}

QFrame#toastWarning {
    background-color: rgba(255, 251, 235, 0.98);
    border: 1px solid rgba(255, 149, 0, 0.3);
    border-radius: 12px;
}

QFrame#toastInfo {
    background-color: rgba(238, 240, 254, 0.98);
    border: 1px solid rgba(78, 91, 242, 0.25);
    border-radius: 12px;
}

/* ─── A/B Test Cards ───────────────────────────────────────────────────── */
QFrame#abCardA {
    background: rgba(78, 91, 242, 0.04);
    border: 1px solid rgba(78, 91, 242, 0.14);
    border-radius: 12px;
}

QFrame#abCardB {
    background: rgba(52, 199, 89, 0.04);
    border: 1px solid rgba(52, 199, 89, 0.14);
    border-radius: 12px;
}

QLabel#abVariantA {
    font-weight: 700;
    font-size: 13px;
    color: #4E5BF2;
    background: transparent;
}

QLabel#abVariantB {
    font-weight: 700;
    font-size: 13px;
    color: #34C759;
    background: transparent;
}

QLabel#abStats {
    color: #6E6E73;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

/* ─── Funnel Bars ──────────────────────────────────────────────────────── */
QWidget#funnelBarBg {
    border-radius: 6px;
    background: #E5E5EA;
}

QWidget#funnelBar {
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4E5BF2, stop:1 rgba(78, 91, 242, 0.55));
    min-width: 4px;
}

/* ─── Chat Panel — Elevated Command Console ───────────────────────────── */
QWidget#chatPanel {
    background-color: #F7F7FE;
    border-left: 1px solid rgba(78, 91, 242, 0.22);
}

QFrame#chatHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 91, 242, 0.12), stop:1 rgba(109, 121, 246, 0.06));
    border-bottom: 1px solid rgba(78, 91, 242, 0.12);
}

QLabel#chatTitle {
    font-size: 14px;
    font-weight: 700;
    color: #1D1D1F;
    background: transparent;
    letter-spacing: 0.3px;
}

QScrollArea#chatScrollArea {
    background: transparent;
    border: none;
}

QWidget#chatMessagesWidget {
    background: transparent;
}

QFrame#chatChipsBar {
    background: rgba(78, 91, 242, 0.03);
    border-top: 1px solid #EDEDF2;
    border-bottom: 1px solid #EDEDF2;
}

QFrame#chatInputBar {
    background: #F0F0F8;
    border-top: 1px solid rgba(78, 91, 242, 0.10);
}

QLineEdit#chatInput {
    background: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #DDDDE5;
    border-radius: 20px;
    height: 38px;
    padding: 0 18px;
    font-size: 13px;
}

QLineEdit#chatInput:focus {
    border: 2px solid rgba(78, 91, 242, 0.5);
    padding: 0 17px;
    background: #FFFFFF;
}

QPushButton#chatSendButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4E5BF2, stop:1 #6D79F6);
    color: white;
    border-radius: 19px;
    font-size: 18px;
    font-weight: bold;
    border: none;
}

QPushButton#chatSendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6D79F6, stop:1 #8B96FA);
}

QPushButton#chatCloseButton {
    background: rgba(0, 0, 0, 0.05);
    color: #6E6E73;
    border-radius: 15px;
    font-size: 13px;
    border: 1px solid rgba(0, 0, 0, 0.04);
}

QPushButton#chatCloseButton:hover {
    background: rgba(255, 59, 48, 0.08);
    color: #FF3B30;
    border-color: rgba(255, 59, 48, 0.12);
}

QFrame#chatBubbleUser {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4E5BF2, stop:1 #6D79F6);
    border: none;
    border-radius: 16px 16px 4px 16px;
    margin-left: 40px;
}

QFrame#chatBubbleUser QLabel {
    color: #FFFFFF;
    background: transparent;
}

QFrame#chatBubbleAI {
    background: #EDEDF5;
    border: 1px solid #DDDDE8;
    border-radius: 16px 16px 16px 4px;
    margin-right: 40px;
}

QFrame#chatBubbleAI QLabel {
    color: #1D1D1F;
    background: transparent;
}

QFrame#typingIndicator {
    background: #EDEDF5;
    border: 1px solid #DDDDE8;
    border-radius: 16px 16px 16px 4px;
    margin-right: 40px;
}

QLabel#typingDot {
    color: #C7C7CC;
    font-size: 10px;
    background: transparent;
}

QLabel#typingDotActive {
    color: #4E5BF2;
    font-size: 10px;
    background: transparent;
}

QFrame#confirmCard {
    background: rgba(78, 91, 242, 0.04);
    border: 1px solid rgba(78, 91, 242, 0.15);
    border-radius: 14px;
    margin: 4px 0;
}

QLabel#confirmCardTitle {
    color: #1D1D1F;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#confirmCardDetail {
    color: #6E6E73;
    font-size: 11px;
    background: transparent;
}

/* ─── Empty State ──────────────────────────────────────────────────────── */
QWidget#emptyState {
    background: transparent;
}

QLabel#emptyStateIcon {
    font-size: 44px;
    background: transparent;
}

QLabel#emptyStateTitle {
    font-size: 16px;
    font-weight: 700;
    color: #6E6E73;
    background: transparent;
}

QLabel#emptyStateSubtitle {
    font-size: 13px;
    color: #AEAEB2;
    background: transparent;
}

/* ─── Wizard Pages ─────────────────────────────────────────────────────── */
QWidget#wizardPage {
    background-color: #F5F5F7;
}

QLabel#wizardTitle {
    font-size: 26px;
    font-weight: 800;
    color: #1D1D1F;
    letter-spacing: -0.5px;
}

QLabel#wizardSubtitle {
    font-size: 14px;
    color: #6E6E73;
    font-weight: 400;
}

/* ─── Masked Input toggle ──────────────────────────────────────────────── */
QPushButton#maskToggle {
    background: transparent;
    border: 1px solid #D1D1D6;
    border-radius: 6px;
    color: #AEAEB2;
    font-size: 12px;
    padding: 4px 8px;
}

QPushButton#maskToggle:hover {
    background: #F2F2F7;
    color: #6E6E73;
}

/* ─── Budget Page ─────────────────────────────────────────────────────── */
QDoubleSpinBox#budgetInput,
QSpinBox#budgetInput {
    background: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 8px;
    color: #1D1D1F;
    padding: 6px 10px;
    font-size: 13px;
}

QDoubleSpinBox#budgetInput:focus,
QSpinBox#budgetInput:focus {
    border-color: #4E5BF2;
}

QProgressBar#pacingProgressBar {
    background: #F2F2F7;
    border: 1px solid #E8E8ED;
    border-radius: 6px;
    text-align: center;
    color: #6E6E73;
    font-size: 11px;
}

QProgressBar#pacingProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4E5BF2, stop:1 #818CF8);
    border-radius: 5px;
}

QLabel#preflightResult {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
}

QLabel#preflightResultOk {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
    background: rgba(52, 199, 89, 0.1);
    border: 1px solid rgba(52, 199, 89, 0.3);
    color: #2DA44E;
}

QLabel#preflightResultWarning {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
    background: rgba(255, 149, 0, 0.1);
    border: 1px solid rgba(255, 149, 0, 0.3);
    color: #C27800;
}

/* ─── Integrations Page ───────────────────────────────────────────────── */
QLabel#integrationPlatformIcon {
    font-size: 20px;
}

QComboBox#integrationCombo {
    background: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 8px;
    color: #1D1D1F;
    padding: 6px 10px;
    font-size: 13px;
}

QComboBox#integrationCombo:focus {
    border-color: #4E5BF2;
}

QComboBox#integrationCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#integrationCombo QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 6px;
    color: #1D1D1F;
    selection-background-color: rgba(78, 91, 242, 0.15);
}

/* ─── Wizard ──────────────────────────────────────────── */
QLabel#wizardIcon {
    font-size: 56px;
    color: #818CF8;
    background: transparent;
}

QPushButton#wizardSkipLink {
    color: #6B6B80;
    background: transparent;
    border: none;
    font-size: 13px;
}

QPushButton#wizardSkipLink:hover {
    color: #4E5BF2;
}

/* ─── Toast Icons ─────────────────────────────────────── */
QLabel#toastIconSuccess {
    font-size: 16px;
    color: #34C759;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

QLabel#toastIconError {
    font-size: 16px;
    color: #FF3B30;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

QLabel#toastIconWarning {
    font-size: 16px;
    color: #FF9500;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

QLabel#toastIconInfo {
    font-size: 16px;
    color: #818CF8;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

/* ─── Agent Detail Dialog ─────────────────────────────────────── */
QDialog#agentDetailDialog {
    background-color: #F0F0F5;
    border: 1px solid #E0E0E6;
    border-radius: 16px;
}
QLabel#agentDetailEmoji {
    font-size: 48px;
    background: transparent;
}
QLabel#agentCardEmoji {
    font-size: 24px;
    background: transparent;
}
QFrame#agentDetailHeader {
    background-color: #EAEAF0;
    border-bottom: 1px solid #E0E0E6;
}
QFrame#agentDetailFooter {
    background-color: #EAEAF0;
    border-top: 1px solid #E0E0E6;
}
QLabel#agentBodyText {
    font-size: 13px;
    color: #3A3A3F;
    background: transparent;
    padding: 2px 0px;
}
QFrame#agentCardSelected {
    background-color: #EEF0FE;
    border-radius: 16px;
    border: 2px solid rgba(78, 91, 242, 0.45);
}
QFrame#agentCardSelected:hover {
    background-color: #E5E8FD;
    border: 2px solid rgba(78, 91, 242, 0.6);
}
/* Tab widget inside detail panel */
QTabWidget#agentTabs::pane {
    border: none;
    background: transparent;
}
QTabBar#agentTabBar::tab {
    background: transparent;
    color: #AEAEB2;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
    margin-right: 4px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar#agentTabBar::tab:selected {
    color: #4E5BF2;
    border-bottom: 2px solid #4E5BF2;
}
QTabBar#agentTabBar::tab:hover:!selected {
    color: #6E6E73;
    border-bottom: 2px solid #E8E8ED;
}

/* ─── Forge Editor Tabs ───────────────────────────────────────── */
QTabWidget#forgeEditorTabs::pane {
    border: none;
    background: transparent;
}
QTabWidget#forgeEditorTabs > QTabBar::tab {
    background: transparent;
    color: #AEAEB2;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
    margin-right: 4px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabWidget#forgeEditorTabs > QTabBar::tab:selected {
    color: #4E5BF2;
    border-bottom: 2px solid #4E5BF2;
}
QTabWidget#forgeEditorTabs > QTabBar::tab:hover:!selected {
    color: #6E6E73;
    border-bottom: 2px solid #E8E8ED;
}
QTextEdit#forgeJsonEditor {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    background: #F0F0F5;
    border: 1px solid #E8E8ED;
    border-radius: 6px;
    color: #1D1D1F;
    padding: 8px;
}

/* ─── Kanban Board ─────────────────────────────────────────────── */

/* Ticket Card */
QFrame#ticketCard {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 12px;
}
QFrame#ticketCard:hover {
    background-color: #FAFAFC;
    border-color: #DDDDE2;
}

QFrame#ticketCardOverdue {
    background-color: rgba(255, 59, 48, 0.04);
    border: 1px solid rgba(255, 59, 48, 0.2);
    border-radius: 12px;
}
QFrame#ticketCardOverdue:hover {
    background-color: rgba(255, 59, 48, 0.08);
    border-color: rgba(255, 59, 48, 0.3);
}

/* Priority dots */
QLabel#priorityDotCritical {
    color: #FF3B30;
    background: transparent;
    font-size: 10px;
}
QLabel#priorityDotHigh {
    color: #FF9500;
    background: transparent;
    font-size: 10px;
}
QLabel#priorityDotMedium {
    color: #4E5BF2;
    background: transparent;
    font-size: 10px;
}
QLabel#priorityDotLow {
    color: #AEAEB2;
    background: transparent;
    font-size: 10px;
}

/* Card elements */
QLabel#ticketTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1D1D1F;
    background: transparent;
}
QLabel#ticketAssignee {
    font-size: 11px;
    color: #6E6E73;
    background: transparent;
}
QLabel#ticketDueDate {
    font-size: 10px;
    color: #AEAEB2;
    background: transparent;
}
QLabel#ticketLabel {
    font-size: 10px;
    font-weight: 600;
    color: #4E5BF2;
    background: rgba(78, 91, 242, 0.08);
    border-radius: 6px;
    padding: 2px 8px;
}

/* Context menu */
QMenu#ticketContextMenu {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 8px;
    padding: 4px;
    color: #1D1D1F;
}
QMenu#ticketContextMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
}
QMenu#ticketContextMenu::item:selected {
    background-color: rgba(78, 91, 242, 0.1);
}

/* Kanban Column */
QFrame#kanbanColumn {
    background-color: #FAFAFA;
    border: 1px solid #E8E8ED;
    border-radius: 14px;
}
QLabel#kanbanColumnHeader {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #6E6E73;
    background: transparent;
}
QLabel#kanbanColumnCount {
    font-size: 11px;
    font-weight: 700;
    color: #AEAEB2;
    background: #F2F2F7;
    border-radius: 10px;
    padding: 2px 8px;
}

/* Ticket Detail Dialog */
QDialog#ticketDetailDialog {
    background-color: #F0F0F5;
    border: 1px solid #E0E0E6;
    border-radius: 16px;
}
QFrame#ticketDetailHeader {
    background-color: #EAEAF0;
    border-bottom: 1px solid #E0E0E6;
}

/* Comment bubbles */
QFrame#ticketCommentBubble {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 10px;
}
QLabel#ticketCommentAuthor {
    font-size: 11px;
    font-weight: 700;
    color: #4E5BF2;
    background: transparent;
}
QLabel#ticketCommentTime {
    font-size: 10px;
    color: #AEAEB2;
    background: transparent;
}

/* Create Ticket Dialog */
QDialog#createTicketDialog {
    background-color: #F0F0F5;
    border: 1px solid #E0E0E6;
    border-radius: 16px;
}


/* ═══════════════════════════════════════════════════════════════
   Command History
   ═══════════════════════════════════════════════════════════════ */

/* Filter Bar */
QFrame#historyFilterBar {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 12px;
    padding: 8px;
}

/* Command Row */
QFrame#historyCommandRow {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 10px;
}
QFrame#historyCommandRow:hover {
    background-color: #F5F5F7;
    border-color: #D1D1D6;
}

/* Child Row (indented) */
QFrame#historyChildRow {
    background-color: #FAFAFA;
    border: 1px solid #E8E8ED;
    border-radius: 8px;
    margin-left: 24px;
}

/* Source Badges */
QLabel#historySourceBadgeTelegram {
    background-color: rgba(38, 165, 225, 0.1);
    color: #1A8DB8;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeDiscord {
    background-color: rgba(88, 101, 242, 0.1);
    color: #4752C4;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeChat {
    background-color: rgba(78, 91, 242, 0.1);
    color: #3D4BD0;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeSystem {
    background-color: rgba(0, 0, 0, 0.04);
    color: #6E6E73;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeScheduled {
    background-color: rgba(255, 149, 0, 0.1);
    color: #CC7700;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

/* Status Badges */
QLabel#historyStatusCompleted {
    background-color: rgba(52, 199, 89, 0.1);
    color: #248A3D;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historyStatusFailed {
    background-color: rgba(255, 59, 48, 0.1);
    color: #D70015;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historyStatusRunning {
    background-color: rgba(78, 91, 242, 0.1);
    color: #3D4BD0;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historyStatusPending {
    background-color: rgba(255, 149, 0, 0.1);
    color: #CC7700;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

/* Timestamp */
QLabel#historyTimestamp {
    color: #AEAEB2;
    font-size: 11px;
    background: transparent;
}

/* Cost Label */
QLabel#historyCostLabel {
    color: #AEAEB2;
    font-size: 10px;
    background: transparent;
}

/* Expand Button */
QPushButton#historyExpandButton {
    background: transparent;
    border: none;
    color: #AEAEB2;
    font-size: 12px;
}
QPushButton#historyExpandButton:hover {
    color: #4E5BF2;
}

/* Detail Dialog */
QDialog#historyDetailDialog {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 16px;
}

/* Pagination Bar */
QFrame#historyPaginationBar {
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════
   Command Palette (Ctrl+K)
   ═══════════════════════════════════════════════════════════════ */

QFrame#commandPalette {
    background-color: rgba(255, 255, 255, 0.97);
    border: 1px solid rgba(78, 91, 242, 0.2);
    border-radius: 16px;
}

QLineEdit#commandPaletteInput {
    background-color: rgba(0, 0, 0, 0.03);
    border: 1px solid #E8E8ED;
    border-radius: 10px;
    color: #1D1D1F;
    font-size: 15px;
    padding: 10px 14px;
    selection-background-color: rgba(78, 91, 242, 0.25);
}
QLineEdit#commandPaletteInput:focus {
    border: 1px solid rgba(78, 91, 242, 0.4);
}

QListWidget#commandPaletteList {
    background: transparent;
    border: none;
    color: #1D1D1F;
    font-size: 13px;
    outline: none;
}
QListWidget#commandPaletteList::item {
    padding: 8px 14px;
    border-radius: 8px;
    margin: 1px 4px;
}
QListWidget#commandPaletteList::item:selected {
    background-color: rgba(78, 91, 242, 0.12);
    color: #1D1D1F;
}
QListWidget#commandPaletteList::item:hover {
    background-color: rgba(0, 0, 0, 0.04);
}

QLabel#commandPaletteHint {
    color: #AEAEB2;
    font-size: 11px;
}

/* ═══════════════════════════════════════════════════════════════
   Cross-Page Navigation Buttons
   ═══════════════════════════════════════════════════════════════ */

QPushButton#crossNavButton {
    background-color: rgba(78, 91, 242, 0.06);
    border: 1px solid rgba(78, 91, 242, 0.12);
    border-radius: 8px;
    color: #4E5BF2;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
}
QPushButton#crossNavButton:hover {
    background-color: rgba(78, 91, 242, 0.12);
    border: 1px solid rgba(78, 91, 242, 0.25);
}
QPushButton#crossNavButton:pressed {
    background-color: rgba(78, 91, 242, 0.18);
}

/* ═══════════════════════════════════════════════════════════════
   Research Page
   ═══════════════════════════════════════════════════════════════ */
QWidget#researchPage { background: transparent; }
QWidget#researchConfigPanel { margin-bottom: 8px; }
QTableWidget#researchQueue {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 8px;
    gridline-color: #F0F0F2;
    color: #1D1D1F;
}
QTextEdit#researchReportCard {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 8px;
    color: #1D1D1F;
    padding: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════
   Calls Page
   ═══════════════════════════════════════════════════════════════ */
QWidget#callsPage { background: transparent; }
QWidget#callConfigPanel { margin-bottom: 8px; }
QTableWidget#callLogTable {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 8px;
    gridline-color: #F0F0F2;
    color: #1D1D1F;
}
QTableWidget#activeCallCard {
    background-color: rgba(34, 197, 94, 0.05);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 8px;
    gridline-color: #F0F0F2;
    color: #1D1D1F;
}
QTextEdit#callTranscriptPanel {
    background-color: #FFFFFF;
    border: 1px solid #E8E8ED;
    border-radius: 8px;
    color: #1D1D1F;
    padding: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}
