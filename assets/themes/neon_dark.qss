/* ═══════════════════════════════════════════════════════════════════════════
   Aura — Premium Dark Theme
   Ultra-dark base · Electric Indigo accents · Apple/Framer minimalism
   ═══════════════════════════════════════════════════════════════════════════ */

/* ─── Global ────────────────────────────────────────────────────────────── */
QWidget {
    background-color: #09090F;
    color: #FFFFFF;
    font-family: "Inter", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* Prevent label backgrounds from painting over card surfaces */
QLabel {
    background: transparent;
}

QWidget#centralWidget,
QWidget#scrollContent {
    background-color: #09090F;
}

/* ─── Main Window ───────────────────────────────────────────────────────── */
QMainWindow {
    background-color: #09090F;
}

/* ─── Scroll Area ───────────────────────────────────────────────────────── */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#dashboardScroll {
    background-color: #09090F;
}

QScrollArea#dashboardScroll > QWidget {
    background-color: #09090F;
}

/* ─── Sidebar ───────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #0C0C17;
    border-right: 1px solid rgba(255, 255, 255, 0.04);
}

/* Logo */
QLabel#logoText {
    font-size: 20px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.5px;
}

/* Nav section label */
QLabel#navSectionLabel {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2.5px;
    color: rgba(255, 255, 255, 0.25);
    padding: 16px 20px 6px 20px;
    background: transparent;
}

/* Sidebar buttons */
QPushButton#sidebarButton {
    text-align: left;
    padding: 11px 20px;
    border: none;
    border-radius: 10px;
    margin: 2px 10px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.45);
    background-color: transparent;
}

QPushButton#sidebarButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.85);
}

QPushButton#sidebarButton[active="true"] {
    background-color: rgba(10, 132, 255, 0.12);
    color: #FFFFFF;
    font-weight: 600;
    border-left: 3px solid #0A84FF;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-left: 17px;
}

/* Version label at bottom */
QLabel#versionLabel {
    color: rgba(255, 255, 255, 0.2);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
    padding: 6px 14px 10px 14px;
    background: transparent;
}

/* Sidebar bottom accent line */
QWidget#sidebarAccent {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent,
        stop:0.3 rgba(10, 132, 255, 0.35),
        stop:0.7 rgba(10, 132, 255, 0.35),
        stop:1 transparent
    );
}

/* Sidebar separator */
QWidget#separator {
    background-color: rgba(255, 255, 255, 0.04);
}

/* ─── Top Bar ───────────────────────────────────────────────────────────── */
QWidget#topBar {
    background-color: #09090F;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QLabel#pageTitle {
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.3px;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 400;
}

/* Chat toggle button */
QPushButton#chatToggleButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0A84FF, stop:1 #409CFF);
    color: white;
    border-radius: 20px;
    font-size: 18px;
    font-weight: bold;
    border: none;
}

QPushButton#chatToggleButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #409CFF, stop:1 #8B96FA);
}

/* ─── Status Bar ───────────────────────────────────────────────────────── */
QWidget#statusBar {
    background-color: #0C0C17;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
}

QLabel#statusText {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.3);
    font-weight: 500;
    background: transparent;
}

QLabel#statusTextSuccess {
    font-size: 11px;
    color: #22C55E;
    font-weight: 500;
    background: transparent;
}

/* ─── Glass Card (Standard Container) ──────────────────────────────────── */
QFrame#glassCard {
    background-color: rgba(255, 255, 255, 0.025);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.07);
}

QFrame#glassCard:hover {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

/* ─── Stat Card ─────────────────────────────────────────────────────────── */
QFrame#statCard {
    background-color: rgba(255, 255, 255, 0.025);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.07);
}

QLabel#statValue {
    font-size: 34px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -1.5px;
    background: transparent;
}

QLabel#statLabel {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 1.5px;
    background: transparent;
}

/* ─── Typography Hierarchy ─────────────────────────────────────────────── */
QLabel#sectionHeader {
    font-size: 22px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.5px;
    background: transparent;
}

QLabel#sectionSubheader {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
    background: transparent;
}

/* Card section title (e.g., "Pipeline Funnel", "Recent Campaigns") */
QLabel#cardHeader {
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.2px;
    background: transparent;
}

/* Form field labels */
QLabel#formLabel {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
}

/* Warning/info inline text */
QLabel#warningText {
    font-size: 12px;
    font-weight: 600;
    color: #F59E0B;
    background: transparent;
}

QLabel#mutedText {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.25);
    background: transparent;
}

/* ─── Buttons ───────────────────────────────────────────────────────────── */
QPushButton#primaryButton {
    background-color: #0A84FF;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1px;
}

QPushButton#primaryButton:hover {
    background-color: #5D6AF4;
}

QPushButton#primaryButton:pressed {
    background-color: #3D4AD0;
}

QPushButton#primaryButton:disabled {
    background-color: rgba(10, 132, 255, 0.2);
    color: rgba(255, 255, 255, 0.3);
}

QPushButton#secondaryButton {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#secondaryButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.18);
}

QPushButton#secondaryButton:disabled {
    background-color: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.05);
}

QPushButton#dangerButton {
    background-color: rgba(239, 68, 68, 0.15);
    color: #F87171;
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: rgba(239, 68, 68, 0.25);
    color: #FCA5A5;
    border-color: rgba(239, 68, 68, 0.4);
}

/* Dashboard export buttons */
QPushButton#exportButton {
    background: rgba(10, 132, 255, 0.08);
    color: #818CF8;
    border: 1px solid rgba(10, 132, 255, 0.18);
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
    font-size: 11px;
}

QPushButton#exportButton:hover {
    background: rgba(10, 132, 255, 0.15);
    color: #A5B4FC;
}

QPushButton#exportButtonSuccess {
    background: rgba(34, 197, 94, 0.08);
    color: #4ADE80;
    border: 1px solid rgba(34, 197, 94, 0.18);
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
    font-size: 11px;
}

QPushButton#exportButtonSuccess:hover {
    background: rgba(34, 197, 94, 0.15);
    color: #86EFAC;
}

/* Action chip (chat panel suggestions) */
QPushButton#chipButton {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#chipButton:hover {
    background: rgba(10, 132, 255, 0.15);
    color: #A5B4FC;
    border-color: rgba(10, 132, 255, 0.3);
}

/* ─── Inputs ────────────────────────────────────────────────────────────── */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    height: 48px;
    padding: 0 16px;
    font-size: 13px;
    color: #FFFFFF;
    selection-background-color: #0A84FF;
}

QLineEdit:focus {
    border: 2px solid #0A84FF;
    background-color: rgba(10, 132, 255, 0.05);
    padding: 0 15px;
    outline: 0;
}

QLineEdit:disabled {
    background-color: rgba(255, 255, 255, 0.02);
    color: rgba(255, 255, 255, 0.2);
}

QLineEdit[masked="true"] {
    font-family: "JetBrains Mono", "Consolas", monospace;
    letter-spacing: 2px;
}

QSpinBox {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    height: 48px;
    padding: 0 12px;
    font-size: 13px;
    color: #FFFFFF;
}

QSpinBox:focus {
    border: 2px solid #0A84FF;
    background-color: rgba(10, 132, 255, 0.05);
    outline: 0;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 20px;
    border: none;
    background: transparent;
    margin-right: 4px;
}

QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid rgba(255, 255, 255, 0.3);
    height: 0;
    width: 0;
}

QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(255, 255, 255, 0.3);
    height: 0;
    width: 0;
}

QTextEdit {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 13px;
    color: #FFFFFF;
    selection-background-color: #0A84FF;
}

QTextEdit:focus {
    border: 2px solid #0A84FF;
    background-color: rgba(10, 132, 255, 0.05);
    outline: 0;
}

/* ─── Combo Box ────────────────────────────────────────────────────────── */
QComboBox {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    color: #FFFFFF;
    min-height: 20px;
}

QComboBox:hover {
    border-color: rgba(10, 132, 255, 0.5);
}

QComboBox:focus {
    border: 2px solid #0A84FF;
    background-color: rgba(10, 132, 255, 0.05);
    outline: 0;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(255, 255, 255, 0.4);
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #14141F;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: #FFFFFF;
    selection-background-color: rgba(10, 132, 255, 0.25);
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 9px 14px;
    border-radius: 6px;
    margin: 2px;
    color: rgba(255, 255, 255, 0.8);
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(10, 132, 255, 0.15);
    color: #FFFFFF;
}

/* ─── Checkbox ──────────────────────────────────────────────────────────── */
QCheckBox {
    spacing: 10px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.03);
}

QCheckBox::indicator:hover {
    border-color: rgba(10, 132, 255, 0.6);
}

QCheckBox::indicator:checked {
    background-color: #0A84FF;
    border-color: #0A84FF;
}

QCheckBox::indicator:checked:hover {
    background-color: #5D6AF4;
}

/* ─── Table ─────────────────────────────────────────────────────────────── */
QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    font-size: 13px;
    selection-background-color: rgba(10, 132, 255, 0.15);
    selection-color: #FFFFFF;
    alternate-background-color: rgba(255, 255, 255, 0.015);
}

QTableWidget::item {
    padding: 13px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.85);
}

QTableWidget::item:selected {
    background-color: rgba(10, 132, 255, 0.12);
    color: #FFFFFF;
}

QTableWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.03);
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: rgba(255, 255, 255, 0.02);
    color: rgba(255, 255, 255, 0.3);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 12px 16px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

QHeaderView::section:first {
    border-top-left-radius: 0px;
}

/* ─── List Widget ──────────────────────────────────────────────────────── */
QListWidget {
    background-color: transparent;
    border: none;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 11px 14px;
    border-radius: 8px;
    margin: 1px 4px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
}

QListWidget::item:selected {
    background-color: rgba(10, 132, 255, 0.18);
    color: #FFFFFF;
    font-weight: 600;
}

QListWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.9);
}

/* ─── Tab Widget ───────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.35);
    padding: 10px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1px;
}

QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #0A84FF;
}

QTabBar::tab:hover:!selected {
    color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.03);
}

/* ─── Scroll Bar ────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(10, 132, 255, 0.5);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(10, 132, 255, 0.5);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ─── Progress Bar ──────────────────────────────────────────────────────── */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    height: 6px;
    text-align: center;
    font-size: 1px;
    color: transparent;
    border: none;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0A84FF, stop:1 #409CFF);
    border-radius: 3px;
}

/* ─── Splitter ─────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: rgba(255, 255, 255, 0.04);
    width: 1px;
    margin: 4px 0;
}

QSplitter::handle:hover {
    background-color: rgba(10, 132, 255, 0.4);
}

/* ─── Group Box ─────────────────────────────────────────────────────────── */
QGroupBox {
    background-color: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    margin-top: 24px;
    padding: 28px 24px 24px 24px;
    padding-top: 36px;
    font-weight: 600;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 12px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ─── Badges ────────────────────────────────────────────────────────────── */
QLabel#badgeSuccess {
    background-color: rgba(34, 197, 94, 0.15);
    color: #4ADE80;
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QLabel#badgeWarning {
    background-color: rgba(245, 158, 11, 0.15);
    color: #FCD34D;
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QLabel#badgeDanger {
    background-color: rgba(239, 68, 68, 0.15);
    color: #F87171;
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QLabel#badgeInfo {
    background-color: rgba(10, 132, 255, 0.15);
    color: #818CF8;
    border-radius: 8px;
    padding: 4px 14px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

/* ─── Toast Notifications ──────────────────────────────────────────────── */
QLabel#toastMessage {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
}

QPushButton#toastCloseButton {
    border: none;
    color: rgba(255, 255, 255, 0.3);
    font-size: 14px;
    padding: 0;
    min-width: 20px;
    max-width: 20px;
    background: transparent;
}

QPushButton#toastCloseButton:hover {
    color: rgba(255, 255, 255, 0.7);
}

QFrame#toastSuccess {
    background-color: rgba(22, 40, 28, 0.95);
    border: 1px solid rgba(34, 197, 94, 0.25);
    border-radius: 12px;
}

QFrame#toastError {
    background-color: rgba(40, 20, 20, 0.95);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 12px;
}

QFrame#toastWarning {
    background-color: rgba(40, 36, 18, 0.95);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 12px;
}

QFrame#toastInfo {
    background-color: rgba(18, 18, 40, 0.95);
    border: 1px solid rgba(10, 132, 255, 0.25);
    border-radius: 12px;
}

/* ─── A/B Test Cards ───────────────────────────────────────────────────── */
QFrame#abCardA {
    background: rgba(10, 132, 255, 0.05);
    border: 1px solid rgba(10, 132, 255, 0.14);
    border-radius: 12px;
}

QFrame#abCardB {
    background: rgba(34, 197, 94, 0.05);
    border: 1px solid rgba(34, 197, 94, 0.14);
    border-radius: 12px;
}

QLabel#abVariantA {
    font-weight: 700;
    font-size: 13px;
    color: #FFFFFF;
    background: transparent;
}

QLabel#abVariantB {
    font-weight: 700;
    font-size: 13px;
    color: #FFFFFF;
    background: transparent;
}

QLabel#abStats {
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

/* ─── Funnel Bars ──────────────────────────────────────────────────────── */
QWidget#funnelBarBg {
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
}

QWidget#funnelBar {
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0A84FF, stop:1 rgba(10, 132, 255, 0.55));
    min-width: 4px;
}

/* ─── Chat Panel — Elevated Command Console ───────────────────────────── */
QWidget#chatPanel {
    background-color: #0D0F24;
    border-left: 1px solid rgba(10, 132, 255, 0.35);
}

QFrame#chatHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(10, 132, 255, 0.20), stop:1 rgba(109, 121, 246, 0.10));
    border-bottom: 1px solid rgba(10, 132, 255, 0.18);
}

QLabel#chatTitle {
    font-size: 14px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
    background: transparent;
    letter-spacing: 0.3px;
}

QScrollArea#chatScrollArea {
    background: transparent;
    border: none;
}

QWidget#chatMessagesWidget {
    background: transparent;
}

QFrame#chatChipsBar {
    background: rgba(10, 132, 255, 0.04);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QFrame#chatInputBar {
    background: rgba(255, 255, 255, 0.03);
    border-top: 1px solid rgba(10, 132, 255, 0.12);
}

QTextEdit#chatInput, QLineEdit#chatInput {
    background: rgba(255, 255, 255, 0.06);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 16px;
    padding: 8px 16px;
    font-size: 13px;
}

QTextEdit#chatInput:focus, QLineEdit#chatInput:focus {
    border: 2px solid rgba(10, 132, 255, 0.6);
    padding: 7px 15px;
    background: rgba(10, 132, 255, 0.08);
}

QPushButton#chatSendButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0A84FF, stop:1 #409CFF);
    color: white;
    border-radius: 19px;
    font-size: 18px;
    font-weight: bold;
    border: none;
}

QPushButton#chatSendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #409CFF, stop:1 #8B96FA);
}

QPushButton#chatCloseButton {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
    border-radius: 15px;
    font-size: 13px;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton#chatCloseButton:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #F87171;
    border-color: rgba(239, 68, 68, 0.2);
}

QFrame#chatBubbleUser {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0A84FF, stop:1 #409CFF);
    border: none;
    border-radius: 16px 16px 4px 16px;
    margin-left: 40px;
}

QFrame#chatBubbleUser QLabel {
    color: #FFFFFF;
    background: transparent;
}

QFrame#chatBubbleAI {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px 16px 16px 4px;
    margin-right: 40px;
}

QFrame#chatBubbleAI QLabel {
    color: rgba(255, 255, 255, 0.9);
    background: transparent;
}

QFrame#typingIndicator {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px 16px 16px 4px;
    margin-right: 40px;
}

QLabel#typingDot {
    color: rgba(255, 255, 255, 0.2);
    font-size: 10px;
    background: transparent;
}

QLabel#typingDotActive {
    color: #818CF8;
    font-size: 10px;
    background: transparent;
}

QFrame#confirmCard {
    background: rgba(10, 132, 255, 0.06);
    border: 1px solid rgba(10, 132, 255, 0.18);
    border-radius: 14px;
    margin: 4px 0;
}

QLabel#confirmCardTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#confirmCardDetail {
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    background: transparent;
}

/* ─── Thinking Widget (fun animated indicator) ─────────────────────── */
QFrame#thinkingWidget {
    background: rgba(10, 132, 255, 0.08);
    border: 1px solid rgba(10, 132, 255, 0.20);
    border-radius: 16px 16px 16px 4px;
    margin-right: 40px;
}

QLabel#thinkingSpinner {
    color: #818CF8;
    font-size: 16px;
    background: transparent;
}

QLabel#thinkingPhrase {
    color: rgba(255, 255, 255, 0.7);
    font-size: 11px;
    font-style: italic;
    background: transparent;
}

/* ─── Stop Button ──────────────────────────────────────────────────── */
QPushButton#chatStopButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #EF4444, stop:1 #F87171);
    color: white;
    border-radius: 19px;
    font-size: 18px;
    font-weight: bold;
    border: none;
}

QPushButton#chatStopButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F87171, stop:1 #FCA5A5);
}

/* ─── Attach Button ────────────────────────────────────────────────── */
QPushButton#chatAttachButton {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 17px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QPushButton#chatAttachButton:hover {
    background: rgba(10, 132, 255, 0.15);
    border-color: rgba(10, 132, 255, 0.3);
}

/* ─── File Attachment Chips ────────────────────────────────────────── */
QFrame#chatFileBar {
    background: rgba(10, 132, 255, 0.04);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
}

QFrame#fileChip {
    background: rgba(10, 132, 255, 0.12);
    border: 1px solid rgba(10, 132, 255, 0.25);
    border-radius: 12px;
}

QLabel#fileChipName {
    color: rgba(255, 255, 255, 0.8);
    background: transparent;
    font-size: 10px;
}

QPushButton#fileChipRemove {
    background: transparent;
    color: rgba(255, 255, 255, 0.5);
    border: none;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#fileChipRemove:hover {
    color: #EF4444;
}

/* ─── File Download Card ───────────────────────────────────────────── */
QFrame#fileDownloadCard {
    background: rgba(34, 197, 94, 0.06);
    border: 1px solid rgba(34, 197, 94, 0.20);
    border-radius: 14px;
    margin-right: 40px;
}

QLabel#fileCardName {
    color: #FFFFFF;
    background: transparent;
    font-size: 12px;
    font-weight: 700;
}

/* ─── Empty State ──────────────────────────────────────────────────────── */
QWidget#emptyState {
    background: transparent;
}

QLabel#emptyStateIcon {
    font-size: 44px;
    background: transparent;
}

QLabel#emptyStateTitle {
    font-size: 16px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
}

QLabel#emptyStateSubtitle {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.28);
    background: transparent;
}

/* ─── Wizard Pages ─────────────────────────────────────────────────────── */
QWidget#wizardPage {
    background-color: #09090F;
}

QLabel#wizardTitle {
    font-size: 26px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.5px;
}

QLabel#wizardSubtitle {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
}

/* ─── Masked Input toggle ──────────────────────────────────────────────── */
QPushButton#maskToggle {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 12px;
    padding: 4px 8px;
}

QPushButton#maskToggle:hover {
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.7);
}

/* ─── Budget Page ─────────────────────────────────────────────────────── */
QDoubleSpinBox#budgetInput,
QSpinBox#budgetInput {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #FFFFFF;
    padding: 6px 10px;
    font-size: 13px;
}

QDoubleSpinBox#budgetInput:focus,
QSpinBox#budgetInput:focus {
    border-color: #0A84FF;
}

QProgressBar#pacingProgressBar {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    text-align: center;
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
}

QProgressBar#pacingProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0A84FF, stop:1 #818CF8);
    border-radius: 5px;
}

QLabel#preflightResult {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
}

QLabel#preflightResultOk {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #22C55E;
}

QLabel#preflightResultWarning {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #F59E0B;
}

/* ─── Integrations Page ───────────────────────────────────────────────── */
QLabel#integrationPlatformIcon {
    font-size: 20px;
}

QComboBox#integrationCombo {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #FFFFFF;
    padding: 6px 10px;
    font-size: 13px;
}

QComboBox#integrationCombo:focus {
    border-color: #0A84FF;
}

QComboBox#integrationCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#integrationCombo QAbstractItemView {
    background: #14141F;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #FFFFFF;
    selection-background-color: rgba(10, 132, 255, 0.3);
}

/* ─── Wizard ──────────────────────────────────────────── */
QLabel#wizardIcon {
    font-size: 56px;
    color: #818CF8;
    background: transparent;
}

QPushButton#wizardSkipLink {
    color: rgba(255, 255, 255, 0.35);
    background: transparent;
    border: none;
    font-size: 13px;
}

QPushButton#wizardSkipLink:hover {
    color: rgba(255, 255, 255, 0.55);
}

/* ─── Toast Icons ─────────────────────────────────────── */
QLabel#toastIconSuccess {
    font-size: 16px;
    color: #34D399;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

QLabel#toastIconError {
    font-size: 16px;
    color: #F87171;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

QLabel#toastIconWarning {
    font-size: 16px;
    color: #FBBF24;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

QLabel#toastIconInfo {
    font-size: 16px;
    color: #818CF8;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

/* ─── Agent Detail Dialog ─────────────────────────────────────── */
QDialog#agentDetailDialog {
    background-color: #0C0C14;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
}
QLabel#agentDetailEmoji {
    font-size: 48px;
    background: transparent;
}
QLabel#agentCardEmoji {
    font-size: 24px;
    background: transparent;
}
QFrame#agentDetailHeader {
    background-color: rgba(255, 255, 255, 0.025);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
QFrame#agentDetailFooter {
    background-color: rgba(255, 255, 255, 0.02);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}
QLabel#agentBodyText {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
    background: transparent;
    padding: 2px 0px;
}
QFrame#agentCardSelected {
    background-color: rgba(10, 132, 255, 0.10);
    border-radius: 16px;
    border: 2px solid rgba(10, 132, 255, 0.45);
}
QFrame#agentCardSelected:hover {
    background-color: rgba(10, 132, 255, 0.15);
    border: 2px solid rgba(10, 132, 255, 0.6);
}
/* Tab widget inside detail panel */
QTabWidget#agentTabs::pane {
    border: none;
    background: transparent;
}
QTabBar#agentTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
    margin-right: 4px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar#agentTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #0A84FF;
}
QTabBar#agentTabBar::tab:hover:!selected {
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 2px solid rgba(255, 255, 255, 0.15);
}

/* ─── Forge Editor Tabs ───────────────────────────────────────── */
QTabWidget#forgeEditorTabs::pane {
    border: none;
    background: transparent;
}
QTabWidget#forgeEditorTabs > QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
    margin-right: 4px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabWidget#forgeEditorTabs > QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #0A84FF;
}
QTabWidget#forgeEditorTabs > QTabBar::tab:hover:!selected {
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 2px solid rgba(255, 255, 255, 0.15);
}
QTextEdit#forgeJsonEditor {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 6px;
    color: #E0E0FF;
    padding: 8px;
}

/* ─── Kanban Board ─────────────────────────────────────────────── */

/* Ticket Card */
QFrame#ticketCard {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
}
QFrame#ticketCard:hover {
    background-color: rgba(255, 255, 255, 0.055);
    border-color: rgba(255, 255, 255, 0.14);
}

QFrame#ticketCardOverdue {
    background-color: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 12px;
}
QFrame#ticketCardOverdue:hover {
    background-color: rgba(239, 68, 68, 0.10);
    border-color: rgba(239, 68, 68, 0.3);
}

/* Priority dots */
QLabel#priorityDotCritical {
    color: #EF4444;
    background: transparent;
    font-size: 10px;
}
QLabel#priorityDotHigh {
    color: #F59E0B;
    background: transparent;
    font-size: 10px;
}
QLabel#priorityDotMedium {
    color: #0A84FF;
    background: transparent;
    font-size: 10px;
}
QLabel#priorityDotLow {
    color: #6B7280;
    background: transparent;
    font-size: 10px;
}

/* Card elements */
QLabel#ticketTitle {
    font-size: 13px;
    font-weight: 600;
    color: #FFFFFF;
    background: transparent;
}
QLabel#ticketAssignee {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
}
QLabel#ticketDueDate {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.35);
    background: transparent;
}
QLabel#ticketLabel {
    font-size: 10px;
    font-weight: 600;
    color: #818CF8;
    background: rgba(10, 132, 255, 0.12);
    border-radius: 6px;
    padding: 2px 8px;
}

/* Context menu */
QMenu#ticketContextMenu {
    background-color: #14141F;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 4px;
    color: #FFFFFF;
}
QMenu#ticketContextMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
}
QMenu#ticketContextMenu::item:selected {
    background-color: rgba(10, 132, 255, 0.2);
}

/* ─── Hunter Tabs & Campaign Views ─────────────────────────── */

QTabWidget#hunterTabs::pane {
    border: none;
    background: transparent;
}

QTabWidget#hunterTabs > QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    padding: 10px 24px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 600;
}

QTabWidget#hunterTabs > QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #0A84FF;
}

QTabWidget#hunterTabs > QTabBar::tab:hover:!selected {
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 2px solid rgba(10, 132, 255, 0.3);
}

QTableWidget#campaignListTable,
QTableWidget#campaignDetailTable {
    background-color: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.04);
    selection-background-color: rgba(10, 132, 255, 0.15);
    selection-color: #FFFFFF;
}

QTableWidget#campaignListTable::item,
QTableWidget#campaignDetailTable::item {
    padding: 6px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QTableWidget#campaignListTable QHeaderView::section,
QTableWidget#campaignDetailTable QHeaderView::section {
    background-color: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.5);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    padding: 8px 8px;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Kanban Column */
QFrame#kanbanColumn {
    background-color: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
}
QLabel#kanbanColumnHeader {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
}
QLabel#kanbanColumnCount {
    font-size: 11px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 2px 8px;
}

/* Ticket Detail Dialog */
QDialog#ticketDetailDialog {
    background-color: #0C0C14;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
}
QFrame#ticketDetailHeader {
    background-color: rgba(255, 255, 255, 0.025);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

/* Comment bubbles */
QFrame#ticketCommentBubble {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
}
QLabel#ticketCommentAuthor {
    font-size: 11px;
    font-weight: 700;
    color: #818CF8;
    background: transparent;
}
QLabel#ticketCommentTime {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.25);
    background: transparent;
}

/* Create Ticket Dialog */
QDialog#createTicketDialog {
    background-color: #0C0C14;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
}


/* ═══════════════════════════════════════════════════════════════
   Command History
   ═══════════════════════════════════════════════════════════════ */

/* Filter Bar */
QFrame#historyFilterBar {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 8px;
}

/* Command Row */
QFrame#historyCommandRow {
    background-color: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
}
QFrame#historyCommandRow:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
}

/* Child Row (indented) */
QFrame#historyChildRow {
    background-color: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    margin-left: 24px;
}

/* Source Badges */
QLabel#historySourceBadgeTelegram {
    background-color: rgba(38, 165, 225, 0.15);
    color: #26A5E1;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeDiscord {
    background-color: rgba(88, 101, 242, 0.15);
    color: #5865F2;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeChat {
    background-color: rgba(10, 132, 255, 0.15);
    color: #0A84FF;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeSystem {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.5);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeScheduled {
    background-color: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

/* Status Badges */
QLabel#historyStatusCompleted {
    background-color: rgba(34, 197, 94, 0.12);
    color: #22C55E;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historyStatusFailed {
    background-color: rgba(239, 68, 68, 0.12);
    color: #EF4444;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historyStatusRunning {
    background-color: rgba(10, 132, 255, 0.12);
    color: #0A84FF;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historyStatusPending {
    background-color: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

/* Timestamp */
QLabel#historyTimestamp {
    color: rgba(255, 255, 255, 0.35);
    font-size: 11px;
    background: transparent;
}

/* Cost Label */
QLabel#historyCostLabel {
    color: rgba(255, 255, 255, 0.4);
    font-size: 10px;
    background: transparent;
}

/* Expand Button */
QPushButton#historyExpandButton {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.4);
    font-size: 12px;
}
QPushButton#historyExpandButton:hover {
    color: #0A84FF;
}

/* Detail Dialog */
QDialog#historyDetailDialog {
    background-color: #0C0C17;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

/* Pagination Bar */
QFrame#historyPaginationBar {
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════
   Command Palette (Ctrl+K)
   ═══════════════════════════════════════════════════════════════ */

QFrame#commandPalette {
    background-color: rgba(24, 24, 28, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 18px;
}

QLineEdit#commandPaletteInput {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    color: #FFFFFF;
    font-size: 15px;
    padding: 11px 14px;
    selection-background-color: rgba(10, 132, 255, 0.45);
}
QLineEdit#commandPaletteInput:focus {
    border: 1px solid rgba(10, 132, 255, 0.85);
    background-color: rgba(255, 255, 255, 0.06);
}

QListWidget#commandPaletteList {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 13px;
    outline: none;
}
QListWidget#commandPaletteList::item {
    padding: 10px 14px;
    border-radius: 10px;
    margin: 2px 2px;
    color: rgba(235, 235, 245, 0.85);
}
QListWidget#commandPaletteList::item:selected {
    background-color: rgba(255, 255, 255, 0.10);
    color: #FFFFFF;
}
QListWidget#commandPaletteList::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QLabel#commandPaletteHint {
    color: rgba(235, 235, 245, 0.35);
    font-size: 11px;
    letter-spacing: 0.5px;
}

/* ═══════════════════════════════════════════════════════════════
   Cross-Page Navigation Buttons
   ═══════════════════════════════════════════════════════════════ */

QPushButton#crossNavButton {
    background-color: rgba(10, 132, 255, 0.08);
    border: 1px solid rgba(10, 132, 255, 0.15);
    border-radius: 8px;
    color: #0A84FF;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
}
QPushButton#crossNavButton:hover {
    background-color: rgba(10, 132, 255, 0.15);
    border: 1px solid rgba(10, 132, 255, 0.3);
}
QPushButton#crossNavButton:pressed {
    background-color: rgba(10, 132, 255, 0.22);
}

/* ═══════════════════════════════════════════════════════════════
   Research Page
   ═══════════════════════════════════════════════════════════════ */
QWidget#researchPage { background: transparent; }
QWidget#researchConfigPanel { margin-bottom: 8px; }
QTableWidget#researchQueue {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}
QTextEdit#researchReportCard {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    color: #FFFFFF;
    padding: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════
   Calls Page
   ═══════════════════════════════════════════════════════════════ */
QWidget#callsPage { background: transparent; }
QWidget#callConfigPanel { margin-bottom: 8px; }
QTableWidget#callLogTable {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}
QTableWidget#activeCallCard {
    background-color: rgba(34, 197, 94, 0.05);
    border: 1px solid rgba(34, 197, 94, 0.15);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}
QTextEdit#callTranscriptPanel {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    color: #FFFFFF;
    padding: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   LIQUID GLASS v6 — per Apple HIG (Materials, Toolbars) + Adopting Liquid Glass
   Two layers, never mixed:
     • FUNCTIONAL LAYER (floats): sidebar, top/status bars, chat column, menus,
       transient controls. Regular Liquid Glass: luminous charcoal, lensing
       edges (bright top, faint bottom), capsule shapes.
     • CONTENT LAYER (rests): cards, tables, pages. Standard material — quiet,
       barely-there fill, no glass-on-glass.
   One prominent tinted action per surface (#0A84FF); all else monochrome.
   Concentric radii: panels 20 → nested 12 → controls capsule.
   ═══════════════════════════════════════════════════════════════════════════ */

QWidget {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.96);
}

QMainWindow, QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0C0C0E, stop:0.5 #121216, stop:1 #18171C);
}

/* With the native acrylic backdrop active, the window becomes a dark tint
   over the real blurred desktop — genuine Liquid Glass. */
QMainWindow[acrylic="true"] {
    background: rgba(10, 10, 14, 0.22);
}

/* Popups: regular glass, solid enough to read (separate native windows) */
QMenu, QComboBox QAbstractItemView, QToolTip, QCalendarWidget {
    background-color: #202024;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 14px;
    padding: 6px;
}
QMenu::item, QComboBox QAbstractItemView::item {
    background: transparent;
    padding: 8px 14px;
    border-radius: 9px;
}
QMenu::item:selected, QComboBox QAbstractItemView::item:selected {
    background: rgba(255, 255, 255, 0.12);
}

QWidget#centralWidget, QWidget#scrollContent,
QScrollArea#dashboardScroll, QScrollArea#dashboardScroll > QWidget {
    background: transparent;
}

/* ═══ FUNCTIONAL LAYER — Liquid Glass ═══ */

QFrame#topBar, QWidget#topBar {
    background-color: rgba(28, 28, 32, 0.48);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
QWidget#statusBar, QFrame#statusBar {
    background-color: rgba(28, 28, 32, 0.48);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(235, 235, 245, 0.55);
}
QWidget#sidebar {
    background-color: rgba(26, 26, 30, 0.46);
    border-right: 1px solid rgba(255, 255, 255, 0.10);
}

/* Sidebar rows: capsule selection, monochrome symbols (HIG: system tints
   selection; content stays monochrome) */
QPushButton#sidebarButton {
    background: transparent;
    color: rgba(235, 235, 245, 0.65);
    border: 1px solid transparent;
    border-radius: 17px;
    padding: 9px 16px;
    text-align: left;
    font-weight: 600;
}
QPushButton#sidebarButton:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #FFFFFF;
}
QPushButton#sidebarButton:pressed { background: rgba(255, 255, 255, 0.05); }
QPushButton#sidebarButton:checked {
    background: rgba(10, 132, 255, 0.30);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
}
QLabel#navSectionLabel {
    color: rgba(235, 235, 245, 0.40);
    letter-spacing: 1.4px;
    font-weight: 700;
}
QLabel#versionLabel { color: rgba(235, 235, 245, 0.30); }
QLabel#logoText { color: #FFFFFF; letter-spacing: -0.3px; }

/* ═══ CONTENT LAYER — standard material, quiet ═══ */

QFrame#glassCard, QFrame#statCard {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
}
QFrame#glassCard:hover { border: 1px solid rgba(255, 255, 255, 0.10); }
QLabel#cardHeader { color: #FFFFFF; font-weight: 700; letter-spacing: -0.2px; }
QLabel#mutedText { color: rgba(235, 235, 245, 0.60); }
QLabel#statValue { color: #FFFFFF; letter-spacing: -0.5px; }
QLabel#statLabel {
    color: rgba(235, 235, 245, 0.60);
    font-weight: 600;
    letter-spacing: 1.1px;
}
QFrame#kanbanColumn {
    background-color: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 20px;
}

/* Data sheets: content layer, concentric 12 inside 20, roomier rows */
QAbstractItemView {
    background-color: rgba(255, 255, 255, 0.03);
    alternate-background-color: rgba(255, 255, 255, 0.018);
    color: rgba(255, 255, 255, 0.94);
    selection-background-color: rgba(10, 132, 255, 0.30);
    selection-color: #FFFFFF;
}
QTableWidget, QTableView {
    background-color: rgba(255, 255, 255, 0.03);
    alternate-background-color: rgba(255, 255, 255, 0.018);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    gridline-color: transparent;
}
QTableWidget#campaignListTable, QTableWidget#campaignDetailTable {
    background-color: rgba(255, 255, 255, 0.03);
    alternate-background-color: rgba(255, 255, 255, 0.018);
    selection-background-color: rgba(10, 132, 255, 0.30);
    selection-color: #FFFFFF;
}
QTableWidget#campaignListTable::item, QTableWidget#campaignDetailTable::item {
    background: transparent;
    color: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.035);
    padding: 10px 8px;
}
QHeaderView::section {
    background-color: transparent;
    color: rgba(235, 235, 245, 0.55);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 10px;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.6px;
}
QTableCornerButton::section { background: transparent; border: none; }
QComboBox QAbstractItemView {
    background-color: #202024;
    alternate-background-color: #202024;
}

/* ═══ CONTROLS — transient interactive elements may wear glass ═══ */

/* Fields: inset standard material, rounded 12 (concentric within cards) */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: rgba(255, 255, 255, 0.06);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    padding: 9px 13px;
    selection-background-color: rgba(10, 132, 255, 0.45);
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid rgba(10, 132, 255, 0.85);
    background-color: rgba(255, 255, 255, 0.08);
}
QComboBox {
    background-color: rgba(255, 255, 255, 0.06);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    padding: 7px 13px;
}
QComboBox:hover { border: 1px solid rgba(255, 255, 255, 0.18); }
QComboBox:focus { border: 1px solid rgba(10, 132, 255, 0.85); }
QComboBox::drop-down { border: none; width: 26px; }

/* Buttons: capsules. One prominent tinted action; the rest are glass. */
QPushButton#primaryButton {
    background: #0A84FF;
    color: #FFFFFF;
    border: none;
    border-radius: 18px;
    padding: 9px 22px;
    font-weight: 700;
}
QPushButton#primaryButton:hover { background: #2694FF; }
QPushButton#primaryButton:pressed { background: #0870D8; }
QPushButton#secondaryButton {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 18px;
    padding: 9px 20px;
    font-weight: 600;
}
QPushButton#secondaryButton:hover { background: rgba(255, 255, 255, 0.12); }
QPushButton#secondaryButton:pressed { background: rgba(255, 255, 255, 0.06); }
QPushButton:disabled {
    color: rgba(235, 235, 245, 0.30);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.05);
}
QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: rgba(235, 235, 245, 0.30);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* Tabs: floating glass pills, no colored underline (selection = fill) */
QTabBar::tab {
    background: transparent;
    color: rgba(235, 235, 245, 0.55);
    padding: 8px 20px;
    margin: 4px 3px;
    border: 1px solid transparent;
    border-radius: 15px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.11);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
}
QTabBar::tab:hover:!selected {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
}
QTabWidget::pane { border: none; background: transparent; }

/* Scrollbars: overlay-thin */
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 4px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: rgba(255, 255, 255, 0.30); }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 4px; min-width: 30px;
}

/* ═══ CHAT — floating glass column (functional layer) ═══ */
QFrame#chatPanel, QWidget#chatPanel {
    background-color: rgba(26, 26, 30, 0.52);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
}
QFrame#chatHeader {
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
}
QLabel#chatTitle { color: #FFFFFF; font-weight: 700; background: transparent; }
QComboBox#chatModelCombo {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 14px;
    font-size: 11px;
    padding: 5px 12px;
    color: rgba(235, 235, 245, 0.88);
}
QComboBox#chatModelCombo:hover { border-color: rgba(10, 132, 255, 0.60); }
QScrollArea#chatScrollArea, QWidget#chatMessagesWidget { background: transparent; }

QFrame#chatBubbleUser {
    background: #0A84FF;
    border: none;
    border-radius: 18px;
    margin-left: 48px;
}
QFrame#chatBubbleUser QLabel { color: #FFFFFF; background: transparent; }
QFrame#chatBubbleAI {
    background-color: rgba(255, 255, 255, 0.085);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-top: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 18px;
    margin-right: 48px;
}
QFrame#chatBubbleAI QLabel { color: rgba(255, 255, 255, 0.95); background: transparent; }

QFrame#chatInputBar {
    background-color: rgba(255, 255, 255, 0.05);
    border-top: 1px solid rgba(255, 255, 255, 0.10);
}
QTextEdit#chatInput, QLineEdit#chatInput {
    background: rgba(255, 255, 255, 0.07);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 18px;
    padding: 9px 16px;
    font-size: 13px;
}
QTextEdit#chatInput:focus, QLineEdit#chatInput:focus {
    border: 1px solid rgba(10, 132, 255, 0.85);
    background: rgba(255, 255, 255, 0.09);
}
QPushButton#chatSendButton {
    background: #0A84FF;
    border: none;
    border-radius: 19px;
}
QPushButton#chatSendButton:hover { background: #2694FF; }
QPushButton#chatSendButton:pressed { background: #0870D8; }
QPushButton#chatAttachButton {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 17px;
}
QPushButton#chatAttachButton:hover {
    background: rgba(255, 255, 255, 0.12);
}
QPushButton#chatCloseButton {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 15px;
}
QPushButton#chatCloseButton:hover { background: rgba(255, 69, 58, 0.32); }
QPushButton#chatAttachButton:pressed,
QPushButton#chatCloseButton:pressed { background: rgba(255, 255, 255, 0.05); }
QWidget#chatChipsBar, QFrame#chatChipsBar { background: transparent; }
QPushButton#chipButton {
    background: rgba(255, 255, 255, 0.075);
    color: rgba(235, 235, 245, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 14px;
    padding: 5px 15px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#chipButton:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
}
QPushButton#chipButton:pressed { background: rgba(255, 255, 255, 0.06); }
QFrame#thinkingWidget {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 18px;
    margin-right: 48px;
}
QLabel#thinkingSpinner { color: #0A84FF; background: transparent; }
QLabel#thinkingPhrase { color: rgba(235, 235, 245, 0.62); background: transparent; }
QFrame#chatFileBar {
    background: rgba(255, 255, 255, 0.03);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
}
QFrame#fileChip {
    background: rgba(10, 132, 255, 0.16);
    border: 1px solid rgba(10, 132, 255, 0.38);
    border-radius: 13px;
}

/* ─── Status chips: capsule tints ─── */
QLabel#badgeInfo {
    background: rgba(10, 132, 255, 0.15);
    color: #6DB9FF;
    border: 1px solid rgba(10, 132, 255, 0.36);
    border-radius: 11px; padding: 3px 11px;
    font-weight: 600; font-size: 11px; letter-spacing: 0.2px;
}
QLabel#badgeSuccess {
    background: rgba(48, 209, 88, 0.13);
    color: #7BE8A2;
    border: 1px solid rgba(48, 209, 88, 0.34);
    border-radius: 11px; padding: 3px 11px;
    font-weight: 600; font-size: 11px; letter-spacing: 0.2px;
}
QLabel#badgeWarning {
    background: rgba(255, 214, 10, 0.12);
    color: #FFE04D;
    border: 1px solid rgba(255, 214, 10, 0.34);
    border-radius: 11px; padding: 3px 11px;
    font-weight: 600; font-size: 11px; letter-spacing: 0.2px;
}
QLabel#badgeDanger {
    background: rgba(255, 69, 58, 0.13);
    color: #FF8A80;
    border: 1px solid rgba(255, 69, 58, 0.34);
    border-radius: 11px; padding: 3px 11px;
    font-weight: 600; font-size: 11px; letter-spacing: 0.2px;
}

QProgressBar {
    background: rgba(255, 255, 255, 0.06);
    border: none;
    border-radius: 6px;
    text-align: center;
    color: rgba(235, 235, 245, 0.75);
}
QProgressBar::chunk { background: #0A84FF; border-radius: 6px; }

/* ═══ APPLE POLISH v7 — toolbar, status bar, dialogs, controls ═══
   Refines LIQUID GLASS v6. Replace from this marker when re-polishing. */

/* ── Toolbar ribbon: floating glass with page context ── */
QFrame#topBar, QWidget#topBar {
    background-color: rgba(44, 44, 50, 0.40);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
}
QLabel#pageTitle {
    font-size: 15px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.2px;
    background: transparent;
}
QLabel#pageSubtitle {
    font-size: 12px;
    color: rgba(235, 235, 245, 0.55);
    background: transparent;
}
QPushButton#chatToggleButton {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-top: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 17px;
    color: #FFFFFF;
}
QPushButton#chatToggleButton:hover { background: rgba(255, 255, 255, 0.13); }
QPushButton#chatToggleButton:pressed { background: rgba(255, 255, 255, 0.05); }
QPushButton#chatToggleButton:checked {
    background: #0A84FF;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

/* ── Status bar: same glass family as the toolbar ── */
QWidget#statusBar, QFrame#statusBar {
    background-color: rgba(44, 44, 50, 0.40);
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
}
QLabel#statusText {
    font-size: 11px;
    font-weight: 500;
    color: rgba(235, 235, 245, 0.60);
    background: transparent;
}
QLabel#statusTextSuccess {
    font-size: 11px;
    font-weight: 600;
    color: #30D158;
    background: transparent;
}

/* ── Dialogs: elevated sheets; real glass when the acrylic property is set ── */
QDialog { background-color: #1C1C21; }
QDialog[acrylic="true"] { background-color: rgba(18, 18, 22, 0.52); }
QMessageBox { background-color: #1C1C21; }
QMessageBox QLabel { color: rgba(255, 255, 255, 0.95); background: transparent; }

/* Agent detail sheet */
QLabel#agentDetailEmoji {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-top: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 18px;
}
QLabel#agentCardEmoji { background: transparent; }
QFrame#agentDetailHeader {
    background-color: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
QFrame#agentDetailFooter {
    background-color: rgba(255, 255, 255, 0.04);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}
QTabBar#agentTabBar::tab {
    background: transparent;
    color: rgba(235, 235, 245, 0.55);
    padding: 7px 18px;
    margin: 6px 3px;
    border: 1px solid transparent;
    border-radius: 14px;
    font-weight: 600;
}
QTabBar#agentTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.11);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
}
QTabBar#agentTabBar::tab:hover:!selected {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid transparent;
}

/* Forge editor tabs: same floating pills */
QTabWidget#forgeEditorTabs > QTabBar::tab {
    background: transparent;
    color: rgba(235, 235, 245, 0.55);
    padding: 7px 18px;
    margin: 6px 3px;
    border: 1px solid transparent;
    border-radius: 14px;
    font-weight: 600;
}
QTabWidget#forgeEditorTabs > QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.11);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
}
QTabWidget#forgeEditorTabs > QTabBar::tab:hover:!selected {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid transparent;
}

/* ── Destructive action: red-tinted glass capsule ── */
QPushButton#dangerButton {
    background: rgba(255, 69, 58, 0.14);
    color: #FF8A80;
    border: 1px solid rgba(255, 69, 58, 0.36);
    border-top: 1px solid rgba(255, 120, 110, 0.50);
    border-radius: 18px;
    padding: 9px 20px;
    font-weight: 600;
}
QPushButton#dangerButton:hover { background: rgba(255, 69, 58, 0.26); color: #FFFFFF; }
QPushButton#dangerButton:pressed { background: rgba(255, 69, 58, 0.10); }

/* ── Checkboxes and radios: Apple marks ── */
QCheckBox { color: rgba(255, 255, 255, 0.92); spacing: 10px; background: transparent; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.24);
}
QCheckBox::indicator:hover { border: 1px solid rgba(255, 255, 255, 0.38); }
QCheckBox::indicator:checked {
    background: #0A84FF;
    border: 1px solid #0A84FF;
    image: url(assets/icons/qss/check.svg);
}
QCheckBox::indicator:disabled {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
}
QRadioButton { color: rgba(255, 255, 255, 0.92); spacing: 10px; background: transparent; }
QRadioButton::indicator {
    width: 18px; height: 18px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.24);
}
QRadioButton::indicator:checked {
    width: 8px; height: 8px;
    border-radius: 10px;
    background: #FFFFFF;
    border: 6px solid #0A84FF;
}

/* ── Combo chevron: clean SF-style glyph ── */
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow {
    image: url(assets/icons/qss/chevron-down.svg);
    width: 12px; height: 8px;
}

/* Dashboard: quiet content layer (A/B, funnel, exports) */
QFrame#abCardA, QFrame#abCardB {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
}
QLabel#abVariantA { color: #FFFFFF; font-weight: 700; background: transparent; }
QLabel#abVariantB { color: #FFFFFF; font-weight: 700; background: transparent; }
QLabel#abStats { color: rgba(235, 235, 245, 0.60); background: transparent; }
QPushButton#exportButton, QPushButton#exportButtonSuccess {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 17px;
    padding: 8px 18px;
    font-weight: 600;
}
QPushButton#exportButton:hover, QPushButton#exportButtonSuccess:hover {
    background: rgba(255, 255, 255, 0.12);
}
QPushButton#exportButton:pressed, QPushButton#exportButtonSuccess:pressed {
    background: rgba(255, 255, 255, 0.06);
}
QFrame#funnelBar { background-color: #0A84FF; border-radius: 6px; border: none; }
QFrame#funnelBarBg {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    border: none;
}

/* ═══ APPLE POLISH v7.1 — tab pills everywhere, steppers, call table ═══ */

/* Hunter tabs: floating pills, no underline */
QTabWidget#hunterTabs > QTabBar::tab {
    background: transparent;
    color: rgba(235, 235, 245, 0.55);
    padding: 8px 22px;
    margin: 4px 3px;
    border: 1px solid transparent;
    border-radius: 15px;
    font-size: 13px;
    font-weight: 600;
}
QTabWidget#hunterTabs > QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.11);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
}
QTabWidget#hunterTabs > QTabBar::tab:hover:!selected {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid transparent;
}

/* Active calls sheet: quiet content layer, no green cast */
QTableWidget#activeCallCard {
    background-color: rgba(255, 255, 255, 0.03);
    alternate-background-color: rgba(255, 255, 255, 0.018);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    gridline-color: transparent;
    color: rgba(255, 255, 255, 0.94);
}

/* Spin boxes: quiet chevron steppers */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
    border-top-right-radius: 10px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    border: none;
    background: transparent;
    border-bottom-right-radius: 10px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(255, 255, 255, 0.10);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(assets/icons/qss/chevron-up.svg);
    width: 10px; height: 7px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(assets/icons/qss/chevron-down.svg);
    width: 10px; height: 7px;
}

/* Toolbar search capsule (command palette) */
QPushButton#toolbarSearchButton {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(235, 235, 245, 0.60);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 17px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#toolbarSearchButton:hover {
    background: rgba(255, 255, 255, 0.11);
    color: #FFFFFF;
}
QPushButton#toolbarSearchButton:pressed { background: rgba(255, 255, 255, 0.05); }

/* Funnel bars are plain QWidgets — match them as such, flat Apple blue */
QWidget#funnelBar {
    background: #0A84FF;
    border-radius: 6px;
    border: none;
    min-width: 4px;
}
QWidget#funnelBarBg {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    border: none;
}

/* ═══ APPLE POLISH v7.3 — natural control heights, centered button text,
   flush bars with uniform hairlines, divided chat column ═══ */

/* Bars: flush with the window — hairline divider only */
QFrame#topBar, QWidget#topBar {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
QWidget#statusBar, QFrame#statusBar {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}
QWidget#separator { background: rgba(255, 255, 255, 0.08); }
QWidget#sidebarAccent { background: rgba(255, 255, 255, 0.08); }

/* Chat: clearly divided floating column */
QFrame#chatPanel, QWidget#chatPanel {
    background-color: rgba(30, 30, 36, 0.72);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
}

/* ── Fields: natural height from comfortable padding ── */
QLineEdit, QTextEdit, QPlainTextEdit {
    padding: 9px 14px;
    border-radius: 12px;
}
QLineEdit[masked="true"] {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    letter-spacing: 0.3px;
    padding: 9px 14px;
}

/* ── Selectors ── */
QComboBox {
    padding: 9px 34px 9px 14px;
    border-radius: 12px;
}
QComboBox QLineEdit {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 30px;
    border: none;
}
QComboBox::down-arrow {
    image: url(assets/icons/qss/chevron-down.png);
    width: 14px; height: 14px;
}

/* ── Spin boxes ── */
QSpinBox, QDoubleSpinBox {
    padding: 9px 30px 9px 14px;
    border-radius: 12px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 26px; height: 19px;
    border: none;
    background: transparent;
    border-top-right-radius: 11px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 26px; height: 19px;
    border: none;
    background: transparent;
    border-bottom-right-radius: 11px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(255, 255, 255, 0.10);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(assets/icons/qss/chevron-up.png);
    width: 12px; height: 12px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(assets/icons/qss/chevron-down.png);
    width: 12px; height: 12px;
}

/* ── Buttons: capsules, centered semibold labels, one shared metric ── */
QPushButton#primaryButton {
    padding: 10px 24px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
}
QPushButton#secondaryButton, QPushButton#dangerButton,
QPushButton#exportButton, QPushButton#exportButtonSuccess {
    padding: 9px 22px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
}
QPushButton#maskToggle {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-top: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 12px;
}
QPushButton#maskToggle:hover { background: rgba(255, 255, 255, 0.12); }
QPushButton#maskToggle:pressed { background: rgba(255, 255, 255, 0.05); }

/* ═══ APPLE POLISH v7.5 — slim fields, macOS pop-ups, guaranteed capsules ═══ */

/* Sidebar: visible hairline dividing navigation from content */
QWidget#sidebar { border-right: 1px solid rgba(255, 255, 255, 0.12); }

/* Buttons: pinned to 36px so radius 18 is always exactly half */
QPushButton#primaryButton {
    min-height: 18px; max-height: 18px;
    padding: 9px 24px;
    border-radius: 18px;
}
QPushButton#secondaryButton, QPushButton#dangerButton,
QPushButton#exportButton, QPushButton#exportButtonSuccess {
    min-height: 18px; max-height: 18px;
    padding: 8px 22px;
    border-radius: 18px;
}

/* Fields: slim 34px profile, no wasted vertical space */
QLineEdit, QTextEdit, QPlainTextEdit {
    padding: 7px 12px;
    border-radius: 10px;
}
QLineEdit { height: 18px; min-height: 18px; max-height: 18px; }
QLineEdit:focus {
    padding: 7px 12px;
    border: 1px solid rgba(10, 132, 255, 0.90);
    height: 18px;
}
QLineEdit[masked="true"] {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    letter-spacing: 0.3px;
    padding: 7px 12px;
    height: 18px; min-height: 18px; max-height: 18px;
}
QPushButton#maskToggle { border-radius: 10px; }

/* Pop-up selectors: macOS style with accent chevron chip */
QComboBox {
    background-color: rgba(255, 255, 255, 0.07);
    padding: 6px 34px 6px 12px;
    border-radius: 10px;
    height: 20px; min-height: 20px; max-height: 20px;
    font-weight: 500;
}
QComboBox:focus { border: 1px solid rgba(10, 132, 255, 0.90); }
QComboBox QLineEdit {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
    min-height: 20px; max-height: 20px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    height: 20px;
    margin-right: 6px;
    border-radius: 5px;
    background: #0A84FF;
    border: none;
}
QComboBox::drop-down:hover { background: #2694FF; }
QComboBox::down-arrow {
    image: url(assets/icons/qss/chevron-updown.png);
    width: 14px; height: 14px;
}
QComboBox:disabled { color: rgba(235, 235, 245, 0.30); }

/* Menu + list selection: system blue */
QMenu::item:selected, QComboBox QAbstractItemView::item:selected {
    background: #0A84FF;
    color: #FFFFFF;
}

/* Spin boxes: same 34px profile */
QSpinBox, QDoubleSpinBox {
    padding: 6px 28px 6px 12px;
    border-radius: 10px;
    height: 20px; min-height: 20px; max-height: 20px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid rgba(10, 132, 255, 0.90);
    padding: 6px 28px 6px 12px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px; height: 16px;
    border: none;
    background: transparent;
    border-top-right-radius: 9px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px; height: 16px;
    border: none;
    background: transparent;
    border-bottom-right-radius: 9px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(255, 255, 255, 0.10);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(assets/icons/qss/chevron-up-11.png);
    width: 11px; height: 7px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(assets/icons/qss/chevron-down-11.png);
    width: 11px; height: 7px;
}

/* Controls stay content-sized instead of stretching edge to edge */
QComboBox { max-width: 360px; }
QSpinBox, QDoubleSpinBox { max-width: 150px; }
QLineEdit { max-width: 560px; }
QLineEdit#commandPaletteInput { max-width: 4096px; }

/* Hunter tabs: first pill flush with the 32px content edge */
QTabWidget#hunterTabs::tab-bar { left: 29px; }

/* Chat: unmistakable dividing line on the left edge */
QFrame#chatPanel, QWidget#chatPanel {
    border-left: 1px solid rgba(255, 255, 255, 0.35);
}

/* ═══ APPLE POLISH v7.6 — refined selectors, table actions, chat divider ═══ */

/* Pop-up selectors: quiet glass chevron chip */
QComboBox {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding: 6px 32px 6px 12px;
    border-radius: 10px;
    height: 20px; min-height: 20px; max-height: 20px;
    font-weight: 500;
}
QComboBox:hover { background-color: rgba(255, 255, 255, 0.10); }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px; height: 22px;
    margin-right: 5px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.09);
    border: none;
}
QComboBox::drop-down:hover { background: rgba(255, 255, 255, 0.16); }
QComboBox::down-arrow {
    image: url(assets/icons/qss/chevron-updown.png);
    width: 13px; height: 13px;
}

/* The open menu: flat modern sheet, rounded item highlights */
QComboBoxPrivateContainer {
    background: #232328;
    border: 1px solid rgba(255, 255, 255, 0.14);
}
QComboBox QAbstractItemView {
    background-color: #232328;
    alternate-background-color: #232328;
    color: rgba(255, 255, 255, 0.92);
    selection-color: #FFFFFF;
    border: none;
    padding: 6px;
    outline: 0px;
}
QComboBox QAbstractItemView::item {
    background: transparent;
    color: rgba(255, 255, 255, 0.92);
    padding: 8px 12px;
    min-height: 22px;
    border-radius: 8px;
    margin: 1px 2px;
}
QComboBox QAbstractItemView::item:hover { background: rgba(255, 255, 255, 0.09); }
QComboBox QAbstractItemView::item:selected { background: #0A84FF; color: #FFFFFF; }

/* Compact action capsules inside tables */
QPushButton#tableActionButton {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 5px 16px;
    min-height: 16px; max-height: 16px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#tableActionButton:hover { background: rgba(255, 255, 255, 0.13); }
QPushButton#tableActionDanger {
    background: rgba(255, 69, 58, 0.14);
    color: #FF8A80;
    border: 1px solid rgba(255, 69, 58, 0.36);
    border-radius: 14px;
    padding: 5px 14px;
    min-height: 16px; max-height: 16px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#tableActionDanger:hover { background: rgba(255, 69, 58, 0.26); color: #FFFFFF; }

/* Chat divider: a real 1px line on the panel left edge */
QWidget#chatDivider { background-color: rgba(255, 255, 255, 0.30); }
QWidget#chatPanelBody { background: transparent; }

/* ═══ APPLE POLISH v7.7 — chipless selectors, rounded menus, skills list ═══ */

/* Selectors: plain chevron, narrower, no chip */
QComboBox { max-width: 280px; padding: 6px 30px 6px 12px; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    margin-right: 0px;
    border: none;
    border-radius: 0px;
    background: transparent;
}
QComboBox::drop-down:hover { background: transparent; }
QComboBox::down-arrow {
    image: url(assets/icons/qss/chevron-down-14.png);
    width: 14px; height: 9px;
}

/* Rounded floating menu. The container window is frameless, translucent,
   and clipped to a rounded mask in code (_PopupRounder), so the view's
   rounded sheet is the only thing that can show. */
QComboBoxPrivateContainer { background: transparent; border: none; }
QComboBox QAbstractItemView {
    background-color: #232328;
    alternate-background-color: #232328;
    color: rgba(255, 255, 255, 0.92);
    selection-color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 6px;
    outline: 0px;
}

/* Two-pane splitters: invisible handle = clean gutter */
QSplitter::handle { background: transparent; }

/* Forge skills list: rounded rows */
QListWidget#skillList {
    background: transparent;
    border: none;
    outline: 0;
}
QListWidget#skillList::item {
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.90);
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 10px 12px;
    margin: 3px 6px 3px 0px;
}
QListWidget#skillList::item:hover { background: rgba(255, 255, 255, 0.07); }
QListWidget#skillList::item:selected {
    background: rgba(10, 132, 255, 0.22);
    border: 1px solid rgba(10, 132, 255, 0.45);
    color: #FFFFFF;
}


/* API key fields get more room than ordinary inputs */
QLineEdit[masked="true"] { max-width: 760px; }

/* ═══════════════════════════════════════════════════════════════
   Ribbon Search (inline, expands to centre)
   ═══════════════════════════════════════════════════════════════ */

QWidget#ribbonSearchWrap { background: transparent; }

/* Liquid-glass field -- frosted, not transparent, like the selectors. */
QLineEdit#ribbonSearchInput {
    background-color: rgba(42, 42, 48, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 20px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 16px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    selection-background-color: rgba(10, 132, 255, 0.45);
}
QLineEdit#ribbonSearchInput:focus {
    background-color: rgba(48, 48, 55, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 20px;
    padding: 8px 16px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
}

QFrame#ribbonSearchDropdown {
    background-color: rgba(28, 28, 33, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 16px;
}
QListWidget#ribbonSearchList {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 13px;
    outline: none;
}
QListWidget#ribbonSearchList::item {
    padding: 10px 14px;
    border-radius: 10px;
    margin: 2px 2px;
    color: rgba(235, 235, 245, 0.85);
}
QListWidget#ribbonSearchList::item:selected {
    background-color: rgba(255, 255, 255, 0.10);
    color: #FFFFFF;
}
QListWidget#ribbonSearchList::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}
QLabel#ribbonSearchHint {
    color: rgba(235, 235, 245, 0.35);
    font-size: 11px;
    letter-spacing: 0.5px;
}

