/* ═══════════════════════════════════════════════════════════════════════════
   Aura — Premium Dark Theme
   Ultra-dark base · Electric Indigo accents · Apple/Framer minimalism
   ═══════════════════════════════════════════════════════════════════════════ */

/* ─── Global ────────────────────────────────────────────────────────────── */
QWidget {
    background-color: #09090F;
    color: #FFFFFF;
    font-family: "Inter", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 13px;
}

/* Prevent label backgrounds from painting over card surfaces */
QLabel {
    background: transparent;
}

QWidget#centralWidget,
QWidget#scrollContent {
    background-color: #09090F;
}

/* ─── Main Window ───────────────────────────────────────────────────────── */
QMainWindow {
    background-color: #09090F;
}

/* ─── Scroll Area ───────────────────────────────────────────────────────── */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#dashboardScroll {
    background-color: #09090F;
}

QScrollArea#dashboardScroll > QWidget {
    background-color: #09090F;
}

/* ─── Sidebar ───────────────────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #0C0C17;
    border-right: 1px solid rgba(255, 255, 255, 0.04);
}

/* Logo */
QLabel#logoText {
    font-size: 20px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.5px;
}

/* Nav section label */
QLabel#navSectionLabel {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2.5px;
    color: rgba(255, 255, 255, 0.25);
    padding: 16px 20px 6px 20px;
    background: transparent;
}

/* Sidebar buttons */
QPushButton#sidebarButton {
    text-align: left;
    padding: 11px 20px;
    border: none;
    border-radius: 10px;
    margin: 2px 10px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.45);
    background-color: transparent;
}

QPushButton#sidebarButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.85);
}

QPushButton#sidebarButton[active="true"] {
    background-color: rgba(78, 91, 242, 0.12);
    color: #FFFFFF;
    font-weight: 600;
    border-left: 3px solid #4E5BF2;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-left: 17px;
}

/* Version label at bottom */
QLabel#versionLabel {
    color: rgba(255, 255, 255, 0.2);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
    padding: 6px 14px 10px 14px;
    background: transparent;
}

/* Sidebar bottom accent line */
QWidget#sidebarAccent {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent,
        stop:0.3 rgba(78, 91, 242, 0.35),
        stop:0.7 rgba(78, 91, 242, 0.35),
        stop:1 transparent
    );
}

/* Sidebar separator */
QWidget#separator {
    background-color: rgba(255, 255, 255, 0.04);
}

/* ─── Top Bar ───────────────────────────────────────────────────────────── */
QWidget#topBar {
    background-color: #09090F;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QLabel#pageTitle {
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.3px;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 400;
}

/* Chat toggle button */
QPushButton#chatToggleButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4E5BF2, stop:1 #6D79F6);
    color: white;
    border-radius: 20px;
    font-size: 18px;
    font-weight: bold;
    border: none;
}

QPushButton#chatToggleButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6D79F6, stop:1 #8B96FA);
}

/* ─── Status Bar ───────────────────────────────────────────────────────── */
QWidget#statusBar {
    background-color: #0C0C17;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
}

QLabel#statusText {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.3);
    font-weight: 500;
    background: transparent;
}

QLabel#statusTextSuccess {
    font-size: 11px;
    color: #22C55E;
    font-weight: 500;
    background: transparent;
}

/* ─── Glass Card (Standard Container) ──────────────────────────────────── */
QFrame#glassCard {
    background-color: rgba(255, 255, 255, 0.025);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.07);
}

QFrame#glassCard:hover {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

/* ─── Stat Card ─────────────────────────────────────────────────────────── */
QFrame#statCard {
    background-color: rgba(255, 255, 255, 0.025);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.07);
}

QLabel#statValue {
    font-size: 34px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -1.5px;
    background: transparent;
}

QLabel#statLabel {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 1.5px;
    background: transparent;
}

/* ─── Typography Hierarchy ─────────────────────────────────────────────── */
QLabel#sectionHeader {
    font-size: 22px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.5px;
    background: transparent;
}

QLabel#sectionSubheader {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
    background: transparent;
}

/* Card section title (e.g., "Pipeline Funnel", "Recent Campaigns") */
QLabel#cardHeader {
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.2px;
    background: transparent;
}

/* Form field labels */
QLabel#formLabel {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
}

/* Warning/info inline text */
QLabel#warningText {
    font-size: 12px;
    font-weight: 600;
    color: #F59E0B;
    background: transparent;
}

QLabel#mutedText {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.25);
    background: transparent;
}

/* ─── Buttons ───────────────────────────────────────────────────────────── */
QPushButton#primaryButton {
    background-color: #4E5BF2;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1px;
}

QPushButton#primaryButton:hover {
    background-color: #5D6AF4;
}

QPushButton#primaryButton:pressed {
    background-color: #3D4AD0;
}

QPushButton#primaryButton:disabled {
    background-color: rgba(78, 91, 242, 0.2);
    color: rgba(255, 255, 255, 0.3);
}

QPushButton#secondaryButton {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#secondaryButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.18);
}

QPushButton#secondaryButton:disabled {
    background-color: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.05);
}

QPushButton#dangerButton {
    background-color: rgba(239, 68, 68, 0.15);
    color: #F87171;
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: rgba(239, 68, 68, 0.25);
    color: #FCA5A5;
    border-color: rgba(239, 68, 68, 0.4);
}

/* Dashboard export buttons */
QPushButton#exportButton {
    background: rgba(78, 91, 242, 0.08);
    color: #818CF8;
    border: 1px solid rgba(78, 91, 242, 0.18);
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
    font-size: 11px;
}

QPushButton#exportButton:hover {
    background: rgba(78, 91, 242, 0.15);
    color: #A5B4FC;
}

QPushButton#exportButtonSuccess {
    background: rgba(34, 197, 94, 0.08);
    color: #4ADE80;
    border: 1px solid rgba(34, 197, 94, 0.18);
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
    font-size: 11px;
}

QPushButton#exportButtonSuccess:hover {
    background: rgba(34, 197, 94, 0.15);
    color: #86EFAC;
}

/* Action chip (chat panel suggestions) */
QPushButton#chipButton {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#chipButton:hover {
    background: rgba(78, 91, 242, 0.15);
    color: #A5B4FC;
    border-color: rgba(78, 91, 242, 0.3);
}

/* ─── Inputs ────────────────────────────────────────────────────────────── */
QLineEdit {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    height: 48px;
    padding: 0 16px;
    font-size: 13px;
    color: #FFFFFF;
    selection-background-color: #4E5BF2;
}

QLineEdit:focus {
    border: 2px solid #4E5BF2;
    background-color: rgba(78, 91, 242, 0.05);
    padding: 0 15px;
    outline: 0;
}

QLineEdit:disabled {
    background-color: rgba(255, 255, 255, 0.02);
    color: rgba(255, 255, 255, 0.2);
}

QLineEdit[masked="true"] {
    font-family: "JetBrains Mono", "Consolas", monospace;
    letter-spacing: 2px;
}

QSpinBox {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    height: 48px;
    padding: 0 12px;
    font-size: 13px;
    color: #FFFFFF;
}

QSpinBox:focus {
    border: 2px solid #4E5BF2;
    background-color: rgba(78, 91, 242, 0.05);
    outline: 0;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 20px;
    border: none;
    background: transparent;
    margin-right: 4px;
}

QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid rgba(255, 255, 255, 0.3);
    height: 0;
    width: 0;
}

QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(255, 255, 255, 0.3);
    height: 0;
    width: 0;
}

QTextEdit {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 13px;
    color: #FFFFFF;
    selection-background-color: #4E5BF2;
}

QTextEdit:focus {
    border: 2px solid #4E5BF2;
    background-color: rgba(78, 91, 242, 0.05);
    outline: 0;
}

/* ─── Combo Box ────────────────────────────────────────────────────────── */
QComboBox {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    color: #FFFFFF;
    min-height: 20px;
}

QComboBox:hover {
    border-color: rgba(78, 91, 242, 0.5);
}

QComboBox:focus {
    border: 2px solid #4E5BF2;
    background-color: rgba(78, 91, 242, 0.05);
    outline: 0;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(255, 255, 255, 0.4);
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #14141F;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: #FFFFFF;
    selection-background-color: rgba(78, 91, 242, 0.25);
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 9px 14px;
    border-radius: 6px;
    margin: 2px;
    color: rgba(255, 255, 255, 0.8);
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(78, 91, 242, 0.15);
    color: #FFFFFF;
}

/* ─── Checkbox ──────────────────────────────────────────────────────────── */
QCheckBox {
    spacing: 10px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.03);
}

QCheckBox::indicator:hover {
    border-color: rgba(78, 91, 242, 0.6);
}

QCheckBox::indicator:checked {
    background-color: #4E5BF2;
    border-color: #4E5BF2;
}

QCheckBox::indicator:checked:hover {
    background-color: #5D6AF4;
}

/* ─── Table ─────────────────────────────────────────────────────────────── */
QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: transparent;
    font-size: 13px;
    selection-background-color: rgba(78, 91, 242, 0.15);
    selection-color: #FFFFFF;
    alternate-background-color: rgba(255, 255, 255, 0.015);
}

QTableWidget::item {
    padding: 13px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.85);
}

QTableWidget::item:selected {
    background-color: rgba(78, 91, 242, 0.12);
    color: #FFFFFF;
}

QTableWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.03);
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: rgba(255, 255, 255, 0.02);
    color: rgba(255, 255, 255, 0.3);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 12px 16px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

QHeaderView::section:first {
    border-top-left-radius: 0px;
}

/* ─── List Widget ──────────────────────────────────────────────────────── */
QListWidget {
    background-color: transparent;
    border: none;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 11px 14px;
    border-radius: 8px;
    margin: 1px 4px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
}

QListWidget::item:selected {
    background-color: rgba(78, 91, 242, 0.18);
    color: #FFFFFF;
    font-weight: 600;
}

QListWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.9);
}

/* ─── Tab Widget ───────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.35);
    padding: 10px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1px;
}

QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #4E5BF2;
}

QTabBar::tab:hover:!selected {
    color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.03);
}

/* ─── Scroll Bar ────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(78, 91, 242, 0.5);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(78, 91, 242, 0.5);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ─── Progress Bar ──────────────────────────────────────────────────────── */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    height: 6px;
    text-align: center;
    font-size: 1px;
    color: transparent;
    border: none;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4E5BF2, stop:1 #6D79F6);
    border-radius: 3px;
}

/* ─── Splitter ─────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: rgba(255, 255, 255, 0.04);
    width: 1px;
    margin: 4px 0;
}

QSplitter::handle:hover {
    background-color: rgba(78, 91, 242, 0.4);
}

/* ─── Group Box ─────────────────────────────────────────────────────────── */
QGroupBox {
    background-color: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    margin-top: 24px;
    padding: 28px 24px 24px 24px;
    padding-top: 36px;
    font-weight: 600;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 12px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ─── Badges ────────────────────────────────────────────────────────────── */
QLabel#badgeSuccess {
    background-color: rgba(34, 197, 94, 0.15);
    color: #4ADE80;
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QLabel#badgeWarning {
    background-color: rgba(245, 158, 11, 0.15);
    color: #FCD34D;
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QLabel#badgeDanger {
    background-color: rgba(239, 68, 68, 0.15);
    color: #F87171;
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

QLabel#badgeInfo {
    background-color: rgba(78, 91, 242, 0.15);
    color: #818CF8;
    border-radius: 8px;
    padding: 4px 14px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
}

/* ─── Toast Notifications ──────────────────────────────────────────────── */
QLabel#toastMessage {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.88);
    background: transparent;
}

QPushButton#toastCloseButton {
    border: none;
    color: rgba(255, 255, 255, 0.3);
    font-size: 14px;
    padding: 0;
    min-width: 20px;
    max-width: 20px;
    background: transparent;
}

QPushButton#toastCloseButton:hover {
    color: rgba(255, 255, 255, 0.7);
}

QFrame#toastSuccess {
    background-color: rgba(22, 40, 28, 0.95);
    border: 1px solid rgba(34, 197, 94, 0.25);
    border-radius: 12px;
}

QFrame#toastError {
    background-color: rgba(40, 20, 20, 0.95);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 12px;
}

QFrame#toastWarning {
    background-color: rgba(40, 36, 18, 0.95);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 12px;
}

QFrame#toastInfo {
    background-color: rgba(18, 18, 40, 0.95);
    border: 1px solid rgba(78, 91, 242, 0.25);
    border-radius: 12px;
}

/* ─── A/B Test Cards ───────────────────────────────────────────────────── */
QFrame#abCardA {
    background: rgba(78, 91, 242, 0.05);
    border: 1px solid rgba(78, 91, 242, 0.14);
    border-radius: 12px;
}

QFrame#abCardB {
    background: rgba(34, 197, 94, 0.05);
    border: 1px solid rgba(34, 197, 94, 0.14);
    border-radius: 12px;
}

QLabel#abVariantA {
    font-weight: 700;
    font-size: 13px;
    color: #818CF8;
    background: transparent;
}

QLabel#abVariantB {
    font-weight: 700;
    font-size: 13px;
    color: #4ADE80;
    background: transparent;
}

QLabel#abStats {
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

/* ─── Funnel Bars ──────────────────────────────────────────────────────── */
QWidget#funnelBarBg {
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
}

QWidget#funnelBar {
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4E5BF2, stop:1 rgba(78, 91, 242, 0.55));
    min-width: 4px;
}

/* ─── Chat Panel — Elevated Command Console ───────────────────────────── */
QWidget#chatPanel {
    background-color: #0D0F24;
    border-left: 1px solid rgba(78, 91, 242, 0.35);
}

QFrame#chatHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(78, 91, 242, 0.20), stop:1 rgba(109, 121, 246, 0.10));
    border-bottom: 1px solid rgba(78, 91, 242, 0.18);
}

QLabel#chatTitle {
    font-size: 14px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
    background: transparent;
    letter-spacing: 0.3px;
}

QScrollArea#chatScrollArea {
    background: transparent;
    border: none;
}

QWidget#chatMessagesWidget {
    background: transparent;
}

QFrame#chatChipsBar {
    background: rgba(78, 91, 242, 0.04);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QFrame#chatInputBar {
    background: rgba(255, 255, 255, 0.03);
    border-top: 1px solid rgba(78, 91, 242, 0.12);
}

QTextEdit#chatInput, QLineEdit#chatInput {
    background: rgba(255, 255, 255, 0.06);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 16px;
    padding: 8px 16px;
    font-size: 13px;
}

QTextEdit#chatInput:focus, QLineEdit#chatInput:focus {
    border: 2px solid rgba(78, 91, 242, 0.6);
    padding: 7px 15px;
    background: rgba(78, 91, 242, 0.08);
}

QPushButton#chatSendButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4E5BF2, stop:1 #6D79F6);
    color: white;
    border-radius: 19px;
    font-size: 18px;
    font-weight: bold;
    border: none;
}

QPushButton#chatSendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6D79F6, stop:1 #8B96FA);
}

QPushButton#chatCloseButton {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
    border-radius: 15px;
    font-size: 13px;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton#chatCloseButton:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #F87171;
    border-color: rgba(239, 68, 68, 0.2);
}

QFrame#chatBubbleUser {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4E5BF2, stop:1 #6D79F6);
    border: none;
    border-radius: 16px 16px 4px 16px;
    margin-left: 40px;
}

QFrame#chatBubbleUser QLabel {
    color: #FFFFFF;
    background: transparent;
}

QFrame#chatBubbleAI {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px 16px 16px 4px;
    margin-right: 40px;
}

QFrame#chatBubbleAI QLabel {
    color: rgba(255, 255, 255, 0.9);
    background: transparent;
}

QFrame#typingIndicator {
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px 16px 16px 4px;
    margin-right: 40px;
}

QLabel#typingDot {
    color: rgba(255, 255, 255, 0.2);
    font-size: 10px;
    background: transparent;
}

QLabel#typingDotActive {
    color: #818CF8;
    font-size: 10px;
    background: transparent;
}

QFrame#confirmCard {
    background: rgba(78, 91, 242, 0.06);
    border: 1px solid rgba(78, 91, 242, 0.18);
    border-radius: 14px;
    margin: 4px 0;
}

QLabel#confirmCardTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#confirmCardDetail {
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    background: transparent;
}

/* ─── Thinking Widget (fun animated indicator) ─────────────────────── */
QFrame#thinkingWidget {
    background: rgba(78, 91, 242, 0.08);
    border: 1px solid rgba(78, 91, 242, 0.20);
    border-radius: 16px 16px 16px 4px;
    margin-right: 40px;
}

QLabel#thinkingSpinner {
    color: #818CF8;
    font-size: 16px;
    background: transparent;
}

QLabel#thinkingPhrase {
    color: rgba(255, 255, 255, 0.7);
    font-size: 11px;
    font-style: italic;
    background: transparent;
}

/* ─── Stop Button ──────────────────────────────────────────────────── */
QPushButton#chatStopButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #EF4444, stop:1 #F87171);
    color: white;
    border-radius: 19px;
    font-size: 18px;
    font-weight: bold;
    border: none;
}

QPushButton#chatStopButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F87171, stop:1 #FCA5A5);
}

/* ─── Attach Button ────────────────────────────────────────────────── */
QPushButton#chatAttachButton {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 17px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QPushButton#chatAttachButton:hover {
    background: rgba(78, 91, 242, 0.15);
    border-color: rgba(78, 91, 242, 0.3);
}

/* ─── File Attachment Chips ────────────────────────────────────────── */
QFrame#chatFileBar {
    background: rgba(78, 91, 242, 0.04);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
}

QFrame#fileChip {
    background: rgba(78, 91, 242, 0.12);
    border: 1px solid rgba(78, 91, 242, 0.25);
    border-radius: 12px;
}

QLabel#fileChipName {
    color: rgba(255, 255, 255, 0.8);
    background: transparent;
    font-size: 10px;
}

QPushButton#fileChipRemove {
    background: transparent;
    color: rgba(255, 255, 255, 0.5);
    border: none;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#fileChipRemove:hover {
    color: #EF4444;
}

/* ─── File Download Card ───────────────────────────────────────────── */
QFrame#fileDownloadCard {
    background: rgba(34, 197, 94, 0.06);
    border: 1px solid rgba(34, 197, 94, 0.20);
    border-radius: 14px;
    margin-right: 40px;
}

QLabel#fileCardName {
    color: #FFFFFF;
    background: transparent;
    font-size: 12px;
    font-weight: 700;
}

/* ─── Empty State ──────────────────────────────────────────────────────── */
QWidget#emptyState {
    background: transparent;
}

QLabel#emptyStateIcon {
    font-size: 44px;
    background: transparent;
}

QLabel#emptyStateTitle {
    font-size: 16px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
}

QLabel#emptyStateSubtitle {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.28);
    background: transparent;
}

/* ─── Wizard Pages ─────────────────────────────────────────────────────── */
QWidget#wizardPage {
    background-color: #09090F;
}

QLabel#wizardTitle {
    font-size: 26px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.5px;
}

QLabel#wizardSubtitle {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
}

/* ─── Masked Input toggle ──────────────────────────────────────────────── */
QPushButton#maskToggle {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 12px;
    padding: 4px 8px;
}

QPushButton#maskToggle:hover {
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.7);
}

/* ─── Budget Page ─────────────────────────────────────────────────────── */
QDoubleSpinBox#budgetInput,
QSpinBox#budgetInput {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #FFFFFF;
    padding: 6px 10px;
    font-size: 13px;
}

QDoubleSpinBox#budgetInput:focus,
QSpinBox#budgetInput:focus {
    border-color: #4E5BF2;
}

QProgressBar#pacingProgressBar {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    text-align: center;
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
}

QProgressBar#pacingProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4E5BF2, stop:1 #818CF8);
    border-radius: 5px;
}

QLabel#preflightResult {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
}

QLabel#preflightResultOk {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #22C55E;
}

QLabel#preflightResultWarning {
    font-size: 12px;
    padding: 8px 12px;
    border-radius: 6px;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #F59E0B;
}

/* ─── Integrations Page ───────────────────────────────────────────────── */
QLabel#integrationPlatformIcon {
    font-size: 20px;
}

QComboBox#integrationCombo {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #FFFFFF;
    padding: 6px 10px;
    font-size: 13px;
}

QComboBox#integrationCombo:focus {
    border-color: #4E5BF2;
}

QComboBox#integrationCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#integrationCombo QAbstractItemView {
    background: #14141F;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #FFFFFF;
    selection-background-color: rgba(78, 91, 242, 0.3);
}

/* ─── Wizard ──────────────────────────────────────────── */
QLabel#wizardIcon {
    font-size: 56px;
    color: #818CF8;
    background: transparent;
}

QPushButton#wizardSkipLink {
    color: rgba(255, 255, 255, 0.35);
    background: transparent;
    border: none;
    font-size: 13px;
}

QPushButton#wizardSkipLink:hover {
    color: rgba(255, 255, 255, 0.55);
}

/* ─── Toast Icons ─────────────────────────────────────── */
QLabel#toastIconSuccess {
    font-size: 16px;
    color: #34D399;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

QLabel#toastIconError {
    font-size: 16px;
    color: #F87171;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

QLabel#toastIconWarning {
    font-size: 16px;
    color: #FBBF24;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

QLabel#toastIconInfo {
    font-size: 16px;
    color: #818CF8;
    font-weight: bold;
    min-width: 20px;
    background: transparent;
}

/* ─── Agent Detail Dialog ─────────────────────────────────────── */
QDialog#agentDetailDialog {
    background-color: #0C0C14;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
}
QLabel#agentDetailEmoji {
    font-size: 48px;
    background: transparent;
}
QLabel#agentCardEmoji {
    font-size: 24px;
    background: transparent;
}
QFrame#agentDetailHeader {
    background-color: rgba(255, 255, 255, 0.025);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
QFrame#agentDetailFooter {
    background-color: rgba(255, 255, 255, 0.02);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}
QLabel#agentBodyText {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
    background: transparent;
    padding: 2px 0px;
}
QFrame#agentCardSelected {
    background-color: rgba(78, 91, 242, 0.10);
    border-radius: 16px;
    border: 2px solid rgba(78, 91, 242, 0.45);
}
QFrame#agentCardSelected:hover {
    background-color: rgba(78, 91, 242, 0.15);
    border: 2px solid rgba(78, 91, 242, 0.6);
}
/* Tab widget inside detail panel */
QTabWidget#agentTabs::pane {
    border: none;
    background: transparent;
}
QTabBar#agentTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
    margin-right: 4px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar#agentTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #4E5BF2;
}
QTabBar#agentTabBar::tab:hover:!selected {
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 2px solid rgba(255, 255, 255, 0.15);
}

/* ─── Forge Editor Tabs ───────────────────────────────────────── */
QTabWidget#forgeEditorTabs::pane {
    border: none;
    background: transparent;
}
QTabWidget#forgeEditorTabs > QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    font-weight: 600;
    padding: 8px 16px;
    margin-right: 4px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabWidget#forgeEditorTabs > QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #4E5BF2;
}
QTabWidget#forgeEditorTabs > QTabBar::tab:hover:!selected {
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 2px solid rgba(255, 255, 255, 0.15);
}
QTextEdit#forgeJsonEditor {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 6px;
    color: #E0E0FF;
    padding: 8px;
}

/* ─── Kanban Board ─────────────────────────────────────────────── */

/* Ticket Card */
QFrame#ticketCard {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
}
QFrame#ticketCard:hover {
    background-color: rgba(255, 255, 255, 0.055);
    border-color: rgba(255, 255, 255, 0.14);
}

QFrame#ticketCardOverdue {
    background-color: rgba(239, 68, 68, 0.06);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 12px;
}
QFrame#ticketCardOverdue:hover {
    background-color: rgba(239, 68, 68, 0.10);
    border-color: rgba(239, 68, 68, 0.3);
}

/* Priority dots */
QLabel#priorityDotCritical {
    color: #EF4444;
    background: transparent;
    font-size: 10px;
}
QLabel#priorityDotHigh {
    color: #F59E0B;
    background: transparent;
    font-size: 10px;
}
QLabel#priorityDotMedium {
    color: #4E5BF2;
    background: transparent;
    font-size: 10px;
}
QLabel#priorityDotLow {
    color: #6B7280;
    background: transparent;
    font-size: 10px;
}

/* Card elements */
QLabel#ticketTitle {
    font-size: 13px;
    font-weight: 600;
    color: #FFFFFF;
    background: transparent;
}
QLabel#ticketAssignee {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    background: transparent;
}
QLabel#ticketDueDate {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.35);
    background: transparent;
}
QLabel#ticketLabel {
    font-size: 10px;
    font-weight: 600;
    color: #818CF8;
    background: rgba(78, 91, 242, 0.12);
    border-radius: 6px;
    padding: 2px 8px;
}

/* Context menu */
QMenu#ticketContextMenu {
    background-color: #14141F;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 4px;
    color: #FFFFFF;
}
QMenu#ticketContextMenu::item {
    padding: 8px 16px;
    border-radius: 4px;
}
QMenu#ticketContextMenu::item:selected {
    background-color: rgba(78, 91, 242, 0.2);
}

/* ─── Hunter Tabs & Campaign Views ─────────────────────────── */

QTabWidget#hunterTabs::pane {
    border: none;
    background: transparent;
}

QTabWidget#hunterTabs > QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    padding: 10px 24px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 600;
}

QTabWidget#hunterTabs > QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #4E5BF2;
}

QTabWidget#hunterTabs > QTabBar::tab:hover:!selected {
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 2px solid rgba(78, 91, 242, 0.3);
}

QTableWidget#campaignListTable,
QTableWidget#campaignDetailTable {
    background-color: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.04);
    selection-background-color: rgba(78, 91, 242, 0.15);
    selection-color: #FFFFFF;
}

QTableWidget#campaignListTable::item,
QTableWidget#campaignDetailTable::item {
    padding: 6px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QTableWidget#campaignListTable QHeaderView::section,
QTableWidget#campaignDetailTable QHeaderView::section {
    background-color: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.5);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    padding: 8px 8px;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Kanban Column */
QFrame#kanbanColumn {
    background-color: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
}
QLabel#kanbanColumnHeader {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
}
QLabel#kanbanColumnCount {
    font-size: 11px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 2px 8px;
}

/* Ticket Detail Dialog */
QDialog#ticketDetailDialog {
    background-color: #0C0C14;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
}
QFrame#ticketDetailHeader {
    background-color: rgba(255, 255, 255, 0.025);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

/* Comment bubbles */
QFrame#ticketCommentBubble {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
}
QLabel#ticketCommentAuthor {
    font-size: 11px;
    font-weight: 700;
    color: #818CF8;
    background: transparent;
}
QLabel#ticketCommentTime {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.25);
    background: transparent;
}

/* Create Ticket Dialog */
QDialog#createTicketDialog {
    background-color: #0C0C14;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
}


/* ═══════════════════════════════════════════════════════════════
   Command History
   ═══════════════════════════════════════════════════════════════ */

/* Filter Bar */
QFrame#historyFilterBar {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 8px;
}

/* Command Row */
QFrame#historyCommandRow {
    background-color: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
}
QFrame#historyCommandRow:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
}

/* Child Row (indented) */
QFrame#historyChildRow {
    background-color: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    margin-left: 24px;
}

/* Source Badges */
QLabel#historySourceBadgeTelegram {
    background-color: rgba(38, 165, 225, 0.15);
    color: #26A5E1;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeDiscord {
    background-color: rgba(88, 101, 242, 0.15);
    color: #5865F2;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeChat {
    background-color: rgba(78, 91, 242, 0.15);
    color: #4E5BF2;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeSystem {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.5);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historySourceBadgeScheduled {
    background-color: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

/* Status Badges */
QLabel#historyStatusCompleted {
    background-color: rgba(34, 197, 94, 0.12);
    color: #22C55E;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historyStatusFailed {
    background-color: rgba(239, 68, 68, 0.12);
    color: #EF4444;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historyStatusRunning {
    background-color: rgba(78, 91, 242, 0.12);
    color: #4E5BF2;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#historyStatusPending {
    background-color: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 600;
}

/* Timestamp */
QLabel#historyTimestamp {
    color: rgba(255, 255, 255, 0.35);
    font-size: 11px;
    background: transparent;
}

/* Cost Label */
QLabel#historyCostLabel {
    color: rgba(255, 255, 255, 0.4);
    font-size: 10px;
    background: transparent;
}

/* Expand Button */
QPushButton#historyExpandButton {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.4);
    font-size: 12px;
}
QPushButton#historyExpandButton:hover {
    color: #4E5BF2;
}

/* Detail Dialog */
QDialog#historyDetailDialog {
    background-color: #0C0C17;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

/* Pagination Bar */
QFrame#historyPaginationBar {
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════
   Command Palette (Ctrl+K)
   ═══════════════════════════════════════════════════════════════ */

QFrame#commandPalette {
    background-color: rgba(12, 12, 23, 0.96);
    border: 1px solid rgba(78, 91, 242, 0.3);
    border-radius: 16px;
}

QLineEdit#commandPaletteInput {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 15px;
    padding: 10px 14px;
    selection-background-color: rgba(78, 91, 242, 0.4);
}
QLineEdit#commandPaletteInput:focus {
    border: 1px solid rgba(78, 91, 242, 0.5);
}

QListWidget#commandPaletteList {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 13px;
    outline: none;
}
QListWidget#commandPaletteList::item {
    padding: 8px 14px;
    border-radius: 8px;
    margin: 1px 4px;
}
QListWidget#commandPaletteList::item:selected {
    background-color: rgba(78, 91, 242, 0.18);
    color: #FFFFFF;
}
QListWidget#commandPaletteList::item:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

QLabel#commandPaletteHint {
    color: rgba(255, 255, 255, 0.3);
    font-size: 11px;
}

/* ═══════════════════════════════════════════════════════════════
   Cross-Page Navigation Buttons
   ═══════════════════════════════════════════════════════════════ */

QPushButton#crossNavButton {
    background-color: rgba(78, 91, 242, 0.08);
    border: 1px solid rgba(78, 91, 242, 0.15);
    border-radius: 8px;
    color: #4E5BF2;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
}
QPushButton#crossNavButton:hover {
    background-color: rgba(78, 91, 242, 0.15);
    border: 1px solid rgba(78, 91, 242, 0.3);
}
QPushButton#crossNavButton:pressed {
    background-color: rgba(78, 91, 242, 0.22);
}

/* ═══════════════════════════════════════════════════════════════
   Research Page
   ═══════════════════════════════════════════════════════════════ */
QWidget#researchPage { background: transparent; }
QWidget#researchConfigPanel { margin-bottom: 8px; }
QTableWidget#researchQueue {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}
QTextEdit#researchReportCard {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    color: #FFFFFF;
    padding: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════
   Calls Page
   ═══════════════════════════════════════════════════════════════ */
QWidget#callsPage { background: transparent; }
QWidget#callConfigPanel { margin-bottom: 8px; }
QTableWidget#callLogTable {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}
QTableWidget#activeCallCard {
    background-color: rgba(34, 197, 94, 0.05);
    border: 1px solid rgba(34, 197, 94, 0.15);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.05);
    color: #FFFFFF;
}
QTextEdit#callTranscriptPanel {
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    color: #FFFFFF;
    padding: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════════════════
   GLASS THEME v3 — reference-matched translucency
   Vivid indigo-violet canvas with a diagonal light band; panels float as
   darker translucent navy glass above it (the reference look).
     canvas      #4750C4 → #3A3F9D → light band #4C4FA8 → #37398B → #453D9C
     panel       rgba(16, 20, 58, 0.52)
     elevated    rgba(22, 26, 68, 0.55)
     inset       rgba(10, 12, 40, 0.55)
     hairline    rgba(255, 255, 255, 0.10)
     selection   #5A64F2 → #6E76F7 (bright indigo pill)
     chart gold  #E8C15A     line purple #8F86F0
   ═══════════════════════════════════════════════════════════════════════════ */

QWidget {
    background-color: transparent;
    color: #FFFFFF;
}

QMainWindow, QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4750C4, stop:0.35 #3A3F9D, stop:0.50 #4C4FA8,
        stop:0.65 #37398B, stop:1 #453D9C);
}

QMenu, QComboBox QAbstractItemView, QToolTip, QCalendarWidget {
    background-color: #23285F;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 6px;
}
QMenu::item, QComboBox QAbstractItemView::item {
    background: transparent;
    padding: 7px 14px;
    border-radius: 8px;
}
QMenu::item:selected, QComboBox QAbstractItemView::item:selected {
    background: rgba(110, 118, 247, 0.40);
}

QWidget#centralWidget, QWidget#scrollContent,
QScrollArea#dashboardScroll, QScrollArea#dashboardScroll > QWidget {
    background: transparent;
}

/* ─── Top bar + status bar ─── */
QFrame#topBar, QWidget#topBar {
    background-color: rgba(16, 20, 58, 0.45);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
QWidget#statusBar, QFrame#statusBar {
    background-color: rgba(16, 20, 58, 0.45);
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    color: rgba(255, 255, 255, 0.55);
}

/* ─── Sidebar: floating navy glass rail ─── */
QWidget#sidebar {
    background-color: rgba(16, 20, 58, 0.52);
    border-right: 1px solid rgba(255, 255, 255, 0.10);
}
QPushButton#sidebarButton {
    background: transparent;
    color: rgba(255, 255, 255, 0.65);
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 9px 14px;
    text-align: left;
    font-weight: 600;
}
QPushButton#sidebarButton:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
}
QPushButton#sidebarButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #5A64F2, stop:1 #6E76F7);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #FFFFFF;
}
QLabel#navSectionLabel { color: rgba(255, 255, 255, 0.40); }
QLabel#versionLabel { color: rgba(255, 255, 255, 0.35); }

/* ─── Cards: darker navy glass over the bright canvas ─── */
QFrame#glassCard, QFrame#statCard {
    background-color: rgba(16, 20, 58, 0.52);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 16px;
}
QFrame#glassCard:hover { border: 1px solid rgba(255, 255, 255, 0.18); }
QLabel#cardHeader { color: #FFFFFF; font-weight: 700; }
QLabel#mutedText { color: rgba(255, 255, 255, 0.55); }
QLabel#statValue { color: #FFFFFF; }
QLabel#statLabel { color: rgba(255, 255, 255, 0.58); letter-spacing: 1.2px; }

/* ─── Inputs ─── */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: rgba(10, 12, 40, 0.55);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    padding: 8px 12px;
    selection-background-color: rgba(110, 118, 247, 0.50);
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid rgba(140, 148, 255, 0.75);
    background-color: rgba(10, 12, 40, 0.70);
}
QComboBox {
    background-color: rgba(10, 12, 40, 0.55);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    padding: 6px 12px;
}
QComboBox:hover { border: 1px solid rgba(255, 255, 255, 0.20); }
QComboBox:focus { border: 1px solid rgba(140, 148, 255, 0.75); }
QComboBox::drop-down { border: none; width: 26px; }

/* ─── Buttons ─── */
QPushButton#primaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #5A64F2, stop:1 #6E76F7);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    padding: 9px 20px;
    font-weight: 700;
}
QPushButton#primaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6B74F6, stop:1 #8189F9);
}
QPushButton#secondaryButton {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 9px 18px;
    font-weight: 600;
}
QPushButton#secondaryButton:hover { background: rgba(255, 255, 255, 0.13); }

/* ─── Data views ─── */
QAbstractItemView {
    background-color: rgba(10, 12, 40, 0.45);
    alternate-background-color: rgba(255, 255, 255, 0.03);
    color: #FFFFFF;
    selection-background-color: rgba(110, 118, 247, 0.38);
    selection-color: #FFFFFF;
}
QTableWidget, QTableView {
    background-color: rgba(10, 12, 40, 0.45);
    alternate-background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    gridline-color: rgba(255, 255, 255, 0.05);
}
QTableWidget#campaignListTable, QTableWidget#campaignDetailTable {
    background-color: rgba(10, 12, 40, 0.45);
    alternate-background-color: rgba(255, 255, 255, 0.03);
    selection-background-color: rgba(110, 118, 247, 0.38);
    selection-color: #FFFFFF;
}
QTableWidget#campaignListTable::item, QTableWidget#campaignDetailTable::item {
    background: transparent;
    color: #FFFFFF;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}
QHeaderView::section {
    background-color: rgba(22, 26, 68, 0.60);
    color: rgba(255, 255, 255, 0.60);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    padding: 8px 10px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.6px;
}
QTableCornerButton::section { background: rgba(22, 26, 68, 0.60); border: none; }
QComboBox QAbstractItemView {
    background-color: #23285F;
    alternate-background-color: #23285F;
}

/* ─── Tabs: gold accent like the reference charts ─── */
QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    padding: 9px 22px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}
QTabBar::tab:selected { color: #E8C15A; border-bottom: 2px solid #E8C15A; }
QTabBar::tab:hover:!selected {
    color: rgba(255, 255, 255, 0.85);
    border-bottom: 2px solid rgba(232, 193, 90, 0.40);
}
QTabWidget::pane { border: none; background: transparent; }

/* ─── Scrollbars ─── */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 5px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: rgba(110, 118, 247, 0.65); }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.18);
    border-radius: 5px; min-width: 30px;
}

/* ═══ CHAT — its own floating glass column ═══ */
QFrame#chatPanel, QWidget#chatPanel {
    background-color: rgba(13, 16, 48, 0.62);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
}
QFrame#chatHeader {
    background-color: rgba(22, 26, 68, 0.60);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
QLabel#chatTitle { color: #FFFFFF; font-weight: 700; background: transparent; }
QComboBox#chatModelCombo {
    background-color: rgba(10, 12, 40, 0.60);
    border: 1px solid rgba(110, 118, 247, 0.40);
    border-radius: 10px;
    font-size: 11px;
    padding: 4px 10px;
    color: rgba(255, 255, 255, 0.88);
}
QComboBox#chatModelCombo:hover { border: 1px solid rgba(140, 148, 255, 0.70); }
QScrollArea#chatScrollArea, QWidget#chatMessagesWidget { background: transparent; }

QFrame#chatBubbleUser {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #5A64F2, stop:1 #6E76F7);
    border: none;
    border-radius: 16px;
    margin-left: 44px;
}
QFrame#chatBubbleUser QLabel { color: #FFFFFF; background: transparent; }
QFrame#chatBubbleAI {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 16px;
    margin-right: 44px;
}
QFrame#chatBubbleAI QLabel { color: rgba(255, 255, 255, 0.94); background: transparent; }

QFrame#chatInputBar {
    background-color: rgba(22, 26, 68, 0.55);
    border-top: 1px solid rgba(255, 255, 255, 0.10);
}
QTextEdit#chatInput, QLineEdit#chatInput {
    background: rgba(10, 12, 40, 0.60);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 8px 16px;
    font-size: 13px;
}
QTextEdit#chatInput:focus, QLineEdit#chatInput:focus {
    border: 1px solid rgba(140, 148, 255, 0.75);
    background: rgba(10, 12, 40, 0.75);
}
QPushButton#chatSendButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #5A64F2, stop:1 #6E76F7);
    border: none;
    border-radius: 19px;
}
QPushButton#chatSendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6B74F6, stop:1 #8189F9);
}
QPushButton#chatAttachButton {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 17px;
}
QPushButton#chatAttachButton:hover {
    background: rgba(110, 118, 247, 0.28);
    border-color: rgba(140, 148, 255, 0.55);
}
QPushButton#chatCloseButton {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 15px;
}
QPushButton#chatCloseButton:hover { background: rgba(239, 68, 68, 0.30); }
QWidget#chatChipsBar, QFrame#chatChipsBar { background: transparent; }
QPushButton#chipButton {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.80);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#chipButton:hover {
    background: rgba(110, 118, 247, 0.30);
    border-color: rgba(140, 148, 255, 0.55);
    color: #FFFFFF;
}
QFrame#thinkingWidget {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(140, 148, 255, 0.35);
    border-radius: 16px;
    margin-right: 44px;
}
QLabel#thinkingSpinner { color: #8F86F0; background: transparent; }
QLabel#thinkingPhrase { color: rgba(255, 255, 255, 0.62); background: transparent; }
QFrame#chatFileBar {
    background: rgba(16, 20, 58, 0.40);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}
QFrame#fileChip {
    background: rgba(110, 118, 247, 0.22);
    border: 1px solid rgba(140, 148, 255, 0.45);
    border-radius: 12px;
}

/* ─── Badges ─── */
QLabel#badgeInfo {
    background: rgba(110, 118, 247, 0.20);
    color: #C7CBFF;
    border: 1px solid rgba(140, 148, 255, 0.40);
    border-radius: 10px; padding: 3px 10px; font-weight: 700;
}
QLabel#badgeSuccess {
    background: rgba(52, 211, 153, 0.16);
    color: #7BEFC3;
    border: 1px solid rgba(52, 211, 153, 0.38);
    border-radius: 10px; padding: 3px 10px; font-weight: 700;
}
QLabel#badgeWarning {
    background: rgba(232, 193, 90, 0.16);
    color: #F2D488;
    border: 1px solid rgba(232, 193, 90, 0.40);
    border-radius: 10px; padding: 3px 10px; font-weight: 700;
}
QLabel#badgeDanger {
    background: rgba(248, 113, 113, 0.16);
    color: #FFB4B4;
    border: 1px solid rgba(248, 113, 113, 0.38);
    border-radius: 10px; padding: 3px 10px; font-weight: 700;
}

/* ─── Misc ─── */
QFrame#kanbanColumn {
    background-color: rgba(16, 20, 58, 0.48);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
}
QProgressBar {
    background: rgba(10, 12, 40, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    text-align: center;
    color: rgba(255, 255, 255, 0.75);
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #E8C15A, stop:1 #8F86F0);
    border-radius: 7px;
}


/* ═══════════════════════════════════════════════════════════════════════════
   GLASS v4 POLISH — craft pass (Apple materials + design-eng principles)
   Material weight encodes hierarchy: structural rails are heavier than
   content cards; small chips are lightest. Bright top edges suggest light
   catching each pane. Text over translucency is cool-tinted, never gray.
   Every interactive surface has hover, pressed, focus, and disabled states.
   ═══════════════════════════════════════════════════════════════════════════ */

/* Vibrancy text: cool-tinted hierarchy over translucent surfaces */
QWidget { color: rgba(238, 241, 255, 0.94); }
QLabel#cardHeader {
    color: #FFFFFF;
    font-weight: 700;
    letter-spacing: -0.2px;
}
QLabel#mutedText {
    color: rgba(214, 220, 250, 0.62);
    letter-spacing: 0.2px;
}
QLabel#statLabel {
    color: rgba(214, 220, 250, 0.66);
    font-weight: 700;
    letter-spacing: 1.4px;
}
QLabel#navSectionLabel {
    color: rgba(214, 220, 250, 0.45);
    letter-spacing: 1.6px;
    font-weight: 700;
}

/* Structural rails: heaviest material (deepest, most separated) */
QWidget#sidebar {
    background-color: rgba(11, 14, 42, 0.66);
    border-right: 1px solid rgba(255, 255, 255, 0.10);
}
QFrame#chatPanel, QWidget#chatPanel {
    background-color: rgba(11, 14, 42, 0.70);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
}
QFrame#topBar, QWidget#topBar {
    background-color: rgba(13, 16, 48, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
QWidget#statusBar, QFrame#statusBar {
    background-color: rgba(13, 16, 48, 0.55);
    border-top: 1px solid rgba(255, 255, 255, 0.09);
}

/* Content cards: lighter material, bright top edge catches the light */
QFrame#glassCard, QFrame#statCard {
    background-color: rgba(16, 20, 58, 0.48);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-top: 1px solid rgba(255, 255, 255, 0.17);
    border-radius: 16px;
}
QFrame#glassCard:hover {
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-top: 1px solid rgba(255, 255, 255, 0.24);
}
QFrame#chatHeader {
    background-color: rgba(16, 20, 58, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
}
QFrame#kanbanColumn {
    background-color: rgba(16, 20, 58, 0.44);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
}

/* Tactile pressed states (scale is unavailable in QSS; weight shift instead) */
QPushButton#primaryButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4A53D8, stop:1 #5B63E0);
}
QPushButton#secondaryButton:pressed { background: rgba(255, 255, 255, 0.045); }
QPushButton#sidebarButton:pressed { background: rgba(255, 255, 255, 0.045); }
QPushButton#chipButton:pressed {
    background: rgba(110, 118, 247, 0.40);
    border-color: rgba(140, 148, 255, 0.65);
}
QPushButton#chatSendButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #4A53D8, stop:1 #5B63E0);
}
QPushButton#chatAttachButton:pressed,
QPushButton#chatCloseButton:pressed { background: rgba(255, 255, 255, 0.045); }

/* Disabled states: recede without disappearing */
QPushButton:disabled {
    color: rgba(238, 241, 255, 0.32);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.05);
}
QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
    color: rgba(238, 241, 255, 0.32);
    background: rgba(10, 12, 40, 0.30);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* Data sheets: slightly brighter body text for legibility over glass */
QTableWidget, QTableView, QAbstractItemView { color: rgba(238, 241, 255, 0.92); }
QHeaderView::section {
    color: rgba(214, 220, 250, 0.62);
    letter-spacing: 0.8px;
}

/* Small chips are the lightest material */
QLabel#badgeInfo, QLabel#badgeSuccess, QLabel#badgeWarning, QLabel#badgeDanger {
    font-size: 11px;
    letter-spacing: 0.3px;
}
